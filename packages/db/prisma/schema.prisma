// REQ-CORE-009 — OpenMap system of record (Postgres). Mirrors packages/contracts: every
// enum below is the exact member list of the matching contract constant (tested in
// src/schema.test.ts). Postgres holds the current state; history goes to ClickHouse and the
// dependency graph to Memgraph, both fed from outbox_events.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

