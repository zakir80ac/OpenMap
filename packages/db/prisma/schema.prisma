// ---------------------------------------------------------------------------------------------
// Organization, tenancy, sites
// ---------------------------------------------------------------------------------------------

/// Global root of the digital twin (organizationSchema). One per deployment is typical.
model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  industry        String
  timeZone        String
  defaultLocale   Locale
  regulatoryScope String[]
  airGapped       Boolean
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  tenants       Tenant[]
  businessUnits BusinessUnit[]
  sites         Site[]
  siteLinks     SiteLink[]
  onboarding    OnboardingState?

  @@map("organizations")
}

/// A tenant is the scope of every other row. Business units become tenants.
model Tenant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  /// URL-safe short name used in Keycloak realm roles and Superset row-level security.
  slug           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings     TenantSettings?
  businessUnit BusinessUnit?

  cis                     Ci[]
  ciExternalIds           CiExternalId[]
  relationships           Relationship[]
  discoveryNodes          DiscoveryNode[]
  agents                  Agent[]
  discoveryJobs           DiscoveryJob[]
  collectorRuns           CollectorRun[]
  evidence                Evidence[]
  reconciliationConflicts ReconciliationConflict[]
  outboxEvents            OutboxEvent[]
  assetRecords            AssetRecord[]
  assetAudits             AssetAudit[]
  infraPlans              InfraPlan[]
  bomLines                BomLine[]
  vendorContacts          VendorContact[]
  impactScenarios         ImpactScenario[]
  impactSimulations       ImpactSimulation[]
  impactValidations       ImpactValidation[]
  relationshipSuggestions RelationshipSuggestion[]
  classificationSuggestions ClassificationSuggestion[]
  runbooks                Runbook[]
  readinessFindings       ReadinessFinding[]
  anomalyFindings         AnomalyFinding[]
  dnsZoneSyncs            DnsZoneSync[]
  powerSettings           PowerSettings?
  dnsChanges              DnsChange[]
  runbookStepRuns         RunbookStepRun[]
  incidents               Incident[]
  incidentLinks           IncidentLink[]
  slas                    Sla[]
  slaAssignments          ServiceSlaAssignment[]
  integrationConfigs      IntegrationConfig[]
  integrationDeliveries   IntegrationDelivery[]
  securityAlerts          SecurityAlert[]
  auditLogs               AuditLog[]
  userPreferences         UserPreference[]
  dashboards              Dashboard[]
  assistantConversations  AssistantConversation[]
  customFieldDefinitions  CustomFieldDefinition[]
  importJobs              ImportJob[]
  planReceipts            PlanReceipt[]
  certificateAlerts       CertificateAlert[]
  ciComponents            CiComponent[]
  ciCodeCounters          CiCodeCounter[]

  @@unique([organizationId, slug])
  @@map("tenants")
}

/// tenantSettingsSchema (@openmap/config). One row per tenant, created with TENANT_SETTINGS_DEFAULTS.
model TenantSettings {
  tenantId                    String   @id @db.Uuid
  locale                      Locale
  timeZone                    String
  discoveryIntervalMinutes    Int
  historyRetentionDays        Int
  staleAfterDays              Int
  /// REQ-SEC-005 — days the ClickHouse audit_log copy is kept; default mirrors TENANT_SETTINGS_DEFAULTS.auditRetentionDays.
  auditRetentionDays          Int      @default(2555)
  assistantEnabled            Boolean
  outboundIntegrationsEnabled Boolean
  createdAt                   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// organizationSchema.businessUnits: the organisational name behind a tenant.
model BusinessUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  tenantId       String   @unique @db.Uuid
  name           String
  costCentreCiId String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_units")
}

/// SITE_DR_ROLES (ADR-025).
enum SiteDrRole {
  primary
  dr
  none
}

/// siteSchema
model Site {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  code            String
  name            String
  kind            SiteKind
  tier            Int?
  address         String
  city            String
  countryCode     String         @db.Char(2)
  geoLat          Float?
  geoLon          Float?
  cloudProvider   CloudProvider?
  cloudRegion     String?
  locationCount   Int            @default(1)
  /// siteSchema.facility (ADR-017): null for cloud regions.
  powerCapacityKw Float?
  rackCount       Int?
  designPue       Float?
  /// ADR-025: the site's part in disaster recovery and its business criticality (1 = most critical).
  drRole          SiteDrRole     @default(none)
  criticality     Int?
  ciId            String?        @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linksFrom      SiteLink[]      @relation("SiteLinkFrom")
  linksTo        SiteLink[]      @relation("SiteLinkTo")
  discoveryNodes DiscoveryNode[]

  @@unique([organizationId, code])
  @@map("sites")
}

/// siteLinkSchema
model SiteLink {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  fromSiteId     String   @db.Uuid
  toSiteId       String   @db.Uuid
  kind           LinkKind
  provider       String?
  circuitId      String?
  bandwidthMbps  Int
  diversePaths   Int
  role           LinkRole
  latencyMs      Float?
  /// ADR-025: true when the link carries storage or database replication; what a Node at the A end probes.
  replication    Boolean  @default(false)
  probeTarget    String?
  ciId           String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromSite     Site         @relation("SiteLinkFrom", fields: [fromSiteId], references: [id], onDelete: Cascade)
  toSite       Site         @relation("SiteLinkTo", fields: [toSiteId], references: [id], onDelete: Cascade)

  @@index([fromSiteId])
  @@index([toSiteId])
  @@map("site_links")
}

/// onboardingSchema: wizard progress per organization.
model OnboardingState {
  organizationId String           @id @db.Uuid
  step           OnboardingStep
  completedSteps OnboardingStep[]
  credentialRefs String[]
  integrationIds String[]         @db.Uuid
  seedImports    Json
  generatedAt    DateTime?        @db.Timestamptz(3)
  firstSweepId   String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_states")
}

// ---------------------------------------------------------------------------------------------
// CMDB core: CIs and relationships (bitemporal: validFrom/validTo, observedAt)
// ---------------------------------------------------------------------------------------------

/// ciSchema. One row per CI id holding the current version; validTo is set when the CI is
/// retired and every superseded version is appended to ClickHouse ci_history.
model Ci {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  type              CiType
  /// Values for CI_IDENTITY_KEYS[type], as observed.
  identity          Json
  /// Canonical join of the identity values in key precedence order; reconciliation lookup key.
  identityKey       String
  name              String
  displayName       String
  /// Short code shown on cards, e.g. NET-SW-CORE-1 (ciCode()); unique per tenant among current rows.
  code              String?   @db.VarChar(64)
  layer             CiLayer
  /// userLabelSchema or null.
  userLabel         Json?
  lifecycle         Lifecycle
  attributes        Json
  tags              String[]
  /// REQ-CMDB-015: values for the tenant's custom fields that apply to this type; only people write them.
  customFields      Json      @default("{}")
  /// provenanceSchema, flattened.
  sourceCollectorId String
  sourceNodeId      String
  sourceRunId       String
  sourceConfidence  Float
  observedAt        DateTime  @db.Timestamptz(3)
  validFrom         DateTime  @db.Timestamptz(3)
  validTo           DateTime? @db.Timestamptz(3)
  /// SHA-256 of canonical (type, identity, attributes).
  checksum          String    @db.Char(64)
  /// ADR-045: normalised spellings under which a `*Ref` may name this CI; empty until the reconciler computes them.
  refTokens         String[]  @default([])
  /// ADR-045: identity tuple with each `*Ref` resolved to a CI id; null without refs or while one is unresolved.
  refKey            String?
  /// ADR-045: a `*Ref` of this CI names no single known CI yet; the pending pass retries it in refsCheckedAt order.
  refsPending       Boolean   @default(false)
  refsCheckedAt     DateTime? @db.Timestamptz(3)
  /// Migration 0031: every identity value as a normalised "key=value"; filled by the cis_identity_tokens trigger on
  /// every insert and identity change, and probed (partial GIN index on current rows) to find candidate CIs.
  identityTokens    String[]  @default([])
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalIds       CiExternalId[]
  relationshipsFrom Relationship[]           @relation("RelationshipFrom")
  relationshipsTo   Relationship[]           @relation("RelationshipTo")
  assetRecords      AssetRecord[]            @relation("AssetCi")
  coveredAssets     AssetRecord[]            @relation("AssetSupportContract")
  ownedAssets       AssetRecord[]            @relation("AssetOwnerCostCentre")
  certificateAlerts CertificateAlert[]
  suggestionsFrom   RelationshipSuggestion[] @relation("SuggestionFrom")
  suggestionsTo     RelationshipSuggestion[] @relation("SuggestionTo")
  classificationSuggestions ClassificationSuggestion[]
  components        CiComponent[]

  @@index([tenantId, type])
  @@index([tenantId, code])
  @@index([tenantId, layer])
  @@index([tenantId, validTo])
  @@index([tenantId, lifecycle])
  @@index([tenantId, type, identityKey])
  @@index([tenantId, identityKey])
  @@index([identity(ops: JsonbPathOps)], type: Gin)
  @@index([tenantId, checksum])
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@index([refTokens], type: Gin)
  @@index([tenantId, refKey])
  @@map("cis")
}

/// externalIdSchema: identifiers for a CI in other systems (ITSM sys_id, cloud ARN, asset tag).
model CiExternalId {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  ciId       String   @db.Uuid
  source     String
  externalId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ci     Ci     @relation(fields: [ciId], references: [id], onDelete: Cascade)

  @@unique([ciId, source, externalId])
  @@index([tenantId, source, externalId])
  @@map("ci_external_ids")
}

/// REQ-CMDB-037 (migration 0030): the last numeric suffix handed out per code base, so the cis_unique_code trigger
/// numbers the n-th CI named VLAN100-MGMT without counting the n-1 before it. Written only by that trigger.
model CiCodeCounter {
  tenantId  String   @db.Uuid
  base      String
  last      Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, base])
  @@map("ci_code_counters")
}

/// relationshipSchema. Direction is from → to as the type names it.
model Relationship {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  type              RelationshipType
  fromCiId          String           @db.Uuid
  toCiId            String           @db.Uuid
  attributes        Json
  sourceCollectorId String
  sourceNodeId      String
  sourceRunId       String
  sourceConfidence  Float
  observedAt        DateTime         @db.Timestamptz(3)
  validFrom         DateTime         @db.Timestamptz(3)
  validTo           DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCi Ci     @relation("RelationshipFrom", fields: [fromCiId], references: [id], onDelete: Cascade)
  toCi   Ci     @relation("RelationshipTo", fields: [toCiId], references: [id], onDelete: Cascade)

  @@index([fromCiId])
  @@index([toCiId])
  @@index([tenantId, type])
  @@index([tenantId, validTo])
  @@index([fromCiId, toCiId, type])
  @@map("relationships")
}

/// Unresolved disagreement between sources about one CI field; the reconciler emits
/// openmap.reconciliation.conflict and a user or precedence rule resolves it.
model ReconciliationConflict {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  ciId        String?        @db.Uuid
  type        CiType
  identityKey String
  field       String
  /// Array of { value, source: provenanceSchema, observedAt }.
  candidates  Json
  status      ConflictStatus @default(open)
  chosenValue Json?
  resolvedBy  String?
  resolvedAt  DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, ciId])
  @@map("reconciliation_conflicts")
}

// ---------------------------------------------------------------------------------------------
// Discovery
// ---------------------------------------------------------------------------------------------

/// collectorManifestSchema: global registry of collector binaries, keyed by (id, version).
model CollectorManifest {
  collectorId     String
  version         String
  family          CollectorFamily
  language        CollectorLanguage
  protocols       String[]
  credentialTypes CredentialType[]
  targetKinds     TargetKind[]
  emits           String[]
  contractVersion String
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  @@id([collectorId, version])
  @@index([family])
  @@map("collector_manifests")
}

/// nodeEnrolmentSchema plus mTLS material: a Discovery Node enrolled at a site.
model DiscoveryNode {
  id                     String              @id
  tenantId               String              @db.Uuid
  siteId                 String              @db.Uuid
  status                 NodeEnrolmentStatus
  enrolTokenDigest       String?             @db.Char(64)
  enrolledAt             DateTime?           @db.Timestamptz(3)
  certificateSerial      String?
  certificateFingerprint String?             @db.Char(64)
  certificateExpiresAt   DateTime?           @db.Timestamptz(3)
  version                String?
  lastHeartbeatAt        DateTime?           @db.Timestamptz(3)
  /// Collector ids present on the Node, from its last heartbeat.
  collectorIds           String[]
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  jobs   DiscoveryJob[]
  runs   CollectorRun[]
  agents Agent[]

  @@index([tenantId, siteId])
  @@index([tenantId, certificateExpiresAt])
  @@map("discovery_nodes")
}

/// collectorJobSchema plus scheduling state.
/// A host agent (REQ-DISC-004): enrols through its site's Discovery Node with a one-time token, reports its own
/// inventory over mTLS, and is filed as the `agent` collector against a standing job on that Node.
model Agent {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @db.Uuid
  nodeId                 String
  /// Stable agent identity (the host's fqdn by convention); the certificate CN.
  agentId                String
  status                 NodeEnrolmentStatus
  enrolTokenDigest       String?             @db.Char(64)
  enrolledAt             DateTime?           @db.Timestamptz(3)
  certificateSerial      String?
  certificateFingerprint String?             @db.Char(64)
  certificateExpiresAt   DateTime?           @db.Timestamptz(3)
  version                String?
  lastReportAt           DateTime?           @db.Timestamptz(3)
  /// The standing discovery job every report is recorded against (created on the first report).
  jobId                  String?             @db.Uuid
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  node   DiscoveryNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, agentId])
  @@index([nodeId, status])
  @@map("agents")
}

model DiscoveryJob {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @db.Uuid
  collectorId          String
  nodeId               String
  /// Array of targetSchema.
  targets              Json
  credentialRef        String?
  credentialType       CredentialType
  timeoutMs            Int
  rateLimitConcurrency Int
  rateLimitRps         Float
  options              Json
  scheduledAt          DateTime       @db.Timestamptz(3)
  status               JobStatus      @default(scheduled)
  startedAt            DateTime?      @db.Timestamptz(3)
  finishedAt           DateTime?      @db.Timestamptz(3)
  contractVersion      String
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  node   DiscoveryNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  runs   CollectorRun[]

  @@index([tenantId, status, scheduledAt])
  @@index([nodeId, status])
  @@map("discovery_jobs")
}

/// collectorResultSchema header and metrics; CIs and relationships go through reconciliation.
model CollectorRun {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @db.Uuid
  jobId                String       @db.Uuid
  collectorId          String
  nodeId               String
  status               ResultStatus
  startedAt            DateTime     @db.Timestamptz(3)
  finishedAt           DateTime     @db.Timestamptz(3)
  targetsAttempted     Int
  targetsReached       Int
  cisEmitted           Int
  relationshipsEmitted Int
  durationMs           Int
  /// Array of collectorErrorSchema.
  errors               Json
  contractVersion      String
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job      DiscoveryJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  node     DiscoveryNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([tenantId, startedAt])
  @@index([jobId])
  @@map("collector_runs")
}

/// evidenceSchema: digest of raw collector output kept by the Node under that digest.
model Evidence {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  runId       String       @db.Uuid
  kind        EvidenceKind
  targetKind  TargetKind
  targetValue String
  targetLabel String?
  digest      String       @db.Char(64)
  sizeBytes   BigInt
  capturedAt  DateTime     @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    CollectorRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([tenantId, digest])
  @@map("evidence")
}

// ---------------------------------------------------------------------------------------------
// Outbox
// ---------------------------------------------------------------------------------------------

/// outboxRecordSchema. Readers poll WHERE deliveredAt IS NULL ORDER BY sequence.
model OutboxEvent {
  sequence    BigInt         @id @default(autoincrement())
  eventId     String         @unique @db.Uuid
  tenantId    String         @db.Uuid
  /// EVENT_TYPES member; a string because the list grows with every workstream.
  type        String
  subject     String
  envelope    Json
  pending     OutboxTarget[]
  attempts    Int            @default(0)
  lastError   String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  deliveredAt DateTime?      @db.Timestamptz(3)
  /// REQ-CORE-020: the dispatcher holding the row and until when; an expired lease frees the row for another.
  claimedBy    String?
  claimedUntil DateTime?     @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([deliveredAt])
  @@index([tenantId, type, createdAt])
  @@index([subject])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------------------------
// Asset management
// ---------------------------------------------------------------------------------------------

/// assetRecordSchema. warranty and endOfLife are embedded JSON (warrantySchema, endOfLifeSchema).
model AssetRecord {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @db.Uuid
  ciId                  String?            @db.Uuid
  /// The CI's type when the row was created; a planned asset has none.
  ciType                CiType?
  /// Register layer: the CI's layer, the BOM line's layer or the manual choice.
  layer                 CiLayer
  source                AssetSource
  assetTag              String
  serialNumber          String?
  manufacturer          String?
  model                 String?
  partNumber            String?
  stage                 AssetStage
  stageChangedAt        DateTime           @db.Timestamptz(3)
  locationCiId          String?            @db.Uuid
  custodian             String?
  ownerCostCentreCiId   String?            @db.Uuid
  planId                String?            @db.Uuid
  /// ADR-034: the BOM line a planned unit belongs to; receiving takes units of one line.
  bomLineId             String?            @db.Uuid
  purchasedAt           DateTime?          @db.Date
  purchaseCostAmount    Decimal?           @db.Decimal(18, 2)
  purchaseCostCurrency  String?            @db.Char(3)
  depreciationMethod    DepreciationMethod
  usefulLifeMonths      Int
  residualValueAmount   Decimal            @db.Decimal(18, 2)
  residualValueCurrency String             @db.Char(3)
  warranty              Json?
  /// subscriptionSchema or null (ADR-027): term and credits of a software, SaaS or cloud asset.
  subscription          Json?
  /// supportSchema or null: cover entered on the row itself (the covering contract CI, supportContractId, is the other way).
  support               Json?
  supportContractId     String?            @db.Uuid
  endOfLife             Json?
  stockOnHand           Int?
  stockReorderPoint     Int?
  tags                  String[]
  customFields          Json
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ci              Ci?          @relation("AssetCi", fields: [ciId], references: [id], onDelete: SetNull)
  plan            InfraPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  bomLine         BomLine?     @relation(fields: [bomLineId], references: [id], onDelete: SetNull)
  /// ADR-035: the contract CI covering this asset.
  supportContract Ci?          @relation("AssetSupportContract", fields: [supportContractId], references: [id], onDelete: SetNull)
  ownerCostCentre Ci?          @relation("AssetOwnerCostCentre", fields: [ownerCostCentreCiId], references: [id], onDelete: SetNull)
  audits          AssetAudit[]

  @@unique([tenantId, assetTag])
  @@unique([tenantId, ciId])
  @@index([tenantId, stage])
  @@index([tenantId, layer])
  @@index([tenantId, source])
  @@index([tenantId, serialNumber])
  @@index([ciId])
  @@index([planId])
  @@index([bomLineId])
  @@index([supportContractId])
  @@index([ownerCostCentreCiId])
  @@map("asset_records")
}

/// assetAuditSchema: append-only.
model AssetAudit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  assetId   String   @db.Uuid
  actor     String
  at        DateTime @db.Timestamptz(3)
  field     String
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  AssetRecord @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, at])
  @@map("asset_audits")
}

/// infraPlanSchema. BOM lines are rows in bom_lines; assetIds are asset_records.planId.
model InfraPlan {
  id                    String     @id @default(uuid()) @db.Uuid
  tenantId              String     @db.Uuid
  number                String
  name                  String
  description           String
  kind                  PlanKind
  status                PlanStatus
  owner                 String
  targetSiteCiId        String?    @db.Uuid
  targetRackCiIds       String[]   @db.Uuid
  costCentreCiId        String?    @db.Uuid
  estimatedCostAmount   Decimal?   @db.Decimal(18, 2)
  estimatedCostCurrency String?    @db.Char(3)
  /// Array of { source, id }.
  externalRefs          Json
  plannedLiveAt         DateTime?  @db.Date
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bom      BomLine[]
  assets   AssetRecord[]
  receipts PlanReceipt[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("infra_plans")
}

/// bomLineSchema
model BomLine {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  planId           String   @db.Uuid
  position         Int
  description      String
  manufacturer     String?
  model            String?
  sku              String?
  layer            CiLayer
  quantity         Int
  received         Int      @default(0)
  unitCostAmount   Decimal? @db.Decimal(18, 2)
  unitCostCurrency String?  @db.Char(3)
  vendorCiId       String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     InfraPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  assets   AssetRecord[]
  receipts PlanReceipt[]

  @@unique([planId, position])
  @@map("bom_lines")
}

/// planReceiptSchema (ADR-034): goods received against one BOM line.
model PlanReceipt {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  planId       String   @db.Uuid
  bomLineId    String   @db.Uuid
  quantity     Int
  receivedOn   DateTime @db.Date
  receivedBy   String
  /// ERP order or delivery note number, kept as text (ADR-005: procurement stays in the finance system).
  reference    String?
  locationCiId String?  @db.Uuid
  assetIds     String[] @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan    InfraPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  bomLine BomLine   @relation(fields: [bomLineId], references: [id], onDelete: Cascade)

  @@index([tenantId, planId, createdAt])
  @@map("plan_receipts")
}

/// vendorContactSchema
model VendorContact {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  vendorCiId      String   @db.Uuid
  name            String
  role            String
  email           String?
  phone           String?
  portalUrl       String?
  availability    String?
  escalationLevel Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, vendorCiId])
  @@map("vendor_contacts")
}

// ---------------------------------------------------------------------------------------------
// Impact modeling and incidents
// ---------------------------------------------------------------------------------------------

/// impactScenarioSchema
model ImpactScenario {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  name                  String
  kind                  ScenarioKind
  origin                ScenarioOrigin @default(user)
  failedCiIds           String[]       @db.Uuid
  maxDepth              Int
  honourRedundancy      Boolean
  includeSharedServices Boolean
  evaluatedAt           DateTime?      @db.Timestamptz(3)
  createdBy             String
  changeRefSource       String?
  changeRefId           String?
  /// The runbook to follow if this scenario happens for real (ADR-048).
  runbookId             String?        @db.Uuid
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  simulations ImpactSimulation[]
  runbook     Runbook?           @relation(fields: [runbookId], references: [id], onDelete: SetNull)

  @@index([tenantId, kind])
  @@index([tenantId, origin, createdAt])
  @@map("impact_scenarios")
}

/// impactSimulationSchema. services and recommendations are JSON arrays of the contract shapes.
model ImpactSimulation {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @db.Uuid
  scenarioId               String   @db.Uuid
  ranAt                    DateTime @db.Timestamptz(3)
  durationMs               Int
  failedCiIds              String[] @db.Uuid
  affectedApplicationCiIds String[] @db.Uuid
  /// Array of affectedServiceSchema.
  services                 Json
  servicesDown             Int
  servicesDegraded         Int
  usersAffected            Int
  revenueAtRiskAmount      Decimal? @db.Decimal(18, 2)
  revenueAtRiskCurrency    String?  @db.Char(3)
  recommendations          Json
  createdAt                DateTime @default(now()) @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenario    ImpactScenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  validations ImpactValidation[]

  @@index([scenarioId, ranAt])
  @@index([tenantId, ranAt])
  @@map("impact_simulations")
}

/// impactValidationSchema: a simulation compared with the incident that really happened.
model ImpactValidation {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  simulationId          String   @db.Uuid
  incidentId            String   @db.Uuid
  predictedServiceCiIds String[] @db.Uuid
  actualServiceCiIds    String[] @db.Uuid
  accuracy              Float
  missedServiceCiIds    String[] @db.Uuid
  validatedAt           DateTime @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  simulation ImpactSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  incident   Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([simulationId, incidentId])
  /// One current validation per incident (ADR-047): validating again replaces it.
  @@unique([incidentId])
  @@index([tenantId, validatedAt])
  @@map("impact_validations")
}

/// relationshipSuggestionSchema (ADR-047): a dependency an incident showed and the graph lacks, for review.
/// REQ-AI-002 (ADR-052): a suggested class, layer and type for a CI discovery could only call unknown, from the
/// evidence a port scan left on it. Accepting writes the CI's user label; dismissing keeps the row, so the same CI is
/// not suggested again until its evidence changes (evidenceKey).
model ClassificationSuggestion {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  ciId        String          @db.Uuid
  deviceClass String
  layer       CiLayer
  type        CiType?
  title       String
  description String
  confidence  Float
  /// [{ signal, value, weight }], the classifier's evidence.
  evidence    Json
  /// The evidence the suggestion was made from; new evidence on the CI makes a new suggestion.
  evidenceKey String
  state       SuggestionState @default(open)
  decidedBy   String?
  decidedAt   DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ci     Ci     @relation(fields: [ciId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ciId])
  @@index([tenantId, state])
  @@map("classification_suggestions")
}

model RelationshipSuggestion {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  type           RelationshipType
  fromCiId       String           @db.Uuid
  toCiId         String           @db.Uuid
  reason         String
  occurrences    Int              @default(1)
  lastIncidentId String?          @db.Uuid
  state          SuggestionState  @default(open)
  decidedBy      String?
  decidedAt      DateTime?        @db.Timestamptz(3)
  relationshipId String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCi Ci     @relation("SuggestionFrom", fields: [fromCiId], references: [id], onDelete: Cascade)
  toCi   Ci     @relation("SuggestionTo", fields: [toCiId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromCiId, toCiId, type])
  @@index([tenantId, state, occurrences])
  @@map("relationship_suggestions")
}

/// runbookRecordSchema (ADR-048): a procedure in the tenant's catalogue; steps are runbookSchema.steps.
model Runbook {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  code           String
  title          String
  ownerTeam      String
  lastReviewedAt DateTime? @db.Date
  /// Array of runbookSchema steps: order, instruction, automation, estimatedMinutes.
  steps          Json
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenarios ImpactScenario[]
  incidents Incident[]
  stepRuns  RunbookStepRun[]

  @@unique([tenantId, code])
  @@map("runbooks")
}

/// readinessFindingSchema (ADR-025): one HA / DR readiness rule breached by one site or link CI, from the moment it
/// breached until it cleared; at most one open finding per tenant, rule and subject.
model ReadinessFinding {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  rule        String
  subjectCiId String    @db.Uuid
  state       String
  detail      String
  openedAt    DateTime  @db.Timestamptz(3)
  clearedAt   DateTime? @db.Timestamptz(3)
  incidentId  String?   @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
  @@index([tenantId, rule, subjectCiId, state])
  @@map("readiness_findings")
}

/// REQ-DCIM-005 (ADR-059) — a tenant's power thresholds (percent of a PDU's rating: warning and critical lines) and its
/// energy tariff (price per kWh in its currency). Without a row the DCIM defaults apply and no price is shown.
model PowerSettings {
  tenantId        String   @id @db.Uuid
  warnPercent     Float
  criticalPercent Float
  tariffPerKwh    Decimal? @db.Decimal(12, 6)
  currency        String?  @db.Char(3)
  updatedBy       String
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("power_settings")
}

/// REQ-AI-003 (ADR-053): one finding per rule and subject (the address, the device, the service), open while the rule
/// holds and cleared when it stops; the explanation is the model's, asked for on demand.
/// REQ-IPAM-003 (ADR-055): a DNS zone kept in sync both ways: the authoritative server the zone is transferred from
/// (AXFR) and changes are pushed to (RFC 2136), its TSIG key name and the credential holding the secret, and the site
/// whose Discovery Node reaches the server.
model DnsZoneSync {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  zone          String
  server        String
  port          Int
  tsigKeyName   String?
  tsigAlgorithm String?
  credentialRef String?
  siteId        String    @db.Uuid
  enabled       Boolean   @default(true)
  lastPullAt    DateTime? @db.Timestamptz(3)
  lastPushAt    DateTime? @db.Timestamptz(3)
  lastJobId     String?   @db.Uuid
  lastError     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, zone])
  @@map("dns_zone_syncs")
}

/// REQ-IPAM-003 (ADR-055): a record change requested in OpenMap: pending until the scheduler sends it with the zone's
/// next job (sent), then applied when the zone transfer that follows the update shows it, failed otherwise.
model DnsChange {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  zone        String
  /// add or delete.
  op          String
  name        String
  recordType  String
  value       String
  ttl         Int
  /// pending, sent, applied or failed.
  state       String
  jobId       String?   @db.Uuid
  error       String?
  requestedBy String
  requestedAt DateTime  @default(now()) @db.Timestamptz(3)
  settledAt   DateTime? @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, zone, state])
  @@index([jobId])
  @@map("dns_changes")
}

model AnomalyFinding {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  /// ANOMALY_RULES.
  rule              String
  subjectCiId       String    @db.Uuid
  /// [{ key, value }]: the facts the rule found, shown with the finding and given to the explanation.
  facts             Json
  /// open or cleared.
  state             String
  detectedAt        DateTime  @db.Timestamptz(3)
  lastSeenAt        DateTime  @db.Timestamptz(3)
  clearedAt         DateTime? @db.Timestamptz(3)
  explanation       String?
  explanationLocale String?
  explainedAt       DateTime? @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, rule, subjectCiId])
  @@index([tenantId, state])
  @@map("anomaly_findings")
}

/// RUNBOOK_STEP_OUTCOMES (ADR-048).
enum RunbookStepOutcome {
  done
  triggered
  failed
}

/// runbookStepRunSchema (ADR-048): one step run on an incident, manual or automated.
model RunbookStepRun {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  incidentId    String             @db.Uuid
  runbookId     String?            @db.Uuid
  order         Int
  outcome       RunbookStepOutcome
  actor         String
  note          String?
  integrationId String?            @db.Uuid
  deliveryId    String?            @db.Uuid
  remoteId      String?
  error         String?
  at            DateTime           @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  runbook  Runbook? @relation(fields: [runbookId], references: [id], onDelete: SetNull)

  @@index([incidentId, at])
  @@map("runbook_step_runs")
}

/// Window an SLA's availability target is measured over (ADR-024).
enum SlaWindow {
  calendar_month
  calendar_quarter
  calendar_year
  rolling_30d
}

/// A service level agreement a business service can be held to (ADR-024): the availability target over a window,
/// response and resolution targets by severity, and the burn rate that raises an at-risk alert.
model Sla {
  id                        String    @id @default(uuid()) @db.Uuid
  tenantId                  String    @db.Uuid
  name                      String
  description               String    @default("")
  availabilityTargetPercent Float
  window                    SlaWindow @default(calendar_month)
  /// { severity: { respondMinutes, resolveMinutes } } for the severities the SLA names; others use SLA.defaultTargets.
  responseTargets           Json      @default("{}")
  burnRateAlert             Float
  createdBy                 String
  createdAt                 DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @db.Timestamptz(3)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments ServiceSlaAssignment[]
  incidents   Incident[]

  @@unique([tenantId, name])
  @@map("slas")
}

/// Which SLA a business service is held to; one per service. The service is a CI (type business_service).
model ServiceSlaAssignment {
  tenantId    String   @db.Uuid
  serviceCiId String   @db.Uuid
  slaId       String   @db.Uuid
  assignedBy  String
  assignedAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sla    Sla    @relation(fields: [slaId], references: [id], onDelete: Cascade)

  @@id([tenantId, serviceCiId])
  @@index([slaId])
  @@map("service_sla_assignments")
}

/// An incident opened by BSM correlation, an SLA breach, an integration or a user (openmap.incident.* events).
/// ADR-024 adds the response and resolution deadlines, the assignee, the closing fields and the structured RCA.
model Incident {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @db.Uuid
  title                String
  description          String
  severity             AlertSeverity
  state                IncidentState @default(open)
  /// Service, integration or user that opened it: bsm, sla, an integration vendor or a username.
  source               String
  affectedServiceCiIds String[]      @db.Uuid
  rootCauseCiId        String?       @db.Uuid
  /// Outbox event ids correlated into this incident.
  correlatedEventIds   String[]      @db.Uuid
  openedAt             DateTime      @db.Timestamptz(3)
  acknowledgedAt       DateTime?     @db.Timestamptz(3)
  resolvedAt           DateTime?     @db.Timestamptz(3)
  closedAt             DateTime?     @db.Timestamptz(3)
  /// Person the incident is assigned to (a username); null until assigned.
  assignee             String?
  /// SLA the targets were taken from when the incident opened; null when the service had none (defaults applied).
  slaId                String?       @db.Uuid
  respondBy            DateTime?     @db.Timestamptz(3)
  resolveBy            DateTime?     @db.Timestamptz(3)
  responseBreachedAt   DateTime?     @db.Timestamptz(3)
  resolutionBreachedAt DateTime?     @db.Timestamptz(3)
  resolutionNote       String?
  /// Root cause analysis: { summary, rootCauseCiId, contributingFactors[], correctiveActions[{description, owner, dueAt, done}], owner, dueAt, completedAt, updatedBy, updatedAt }.
  rca                  Json?
  /// The runbook an operator attached (ADR-048).
  runbookId            String?       @db.Uuid
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sla         Sla?               @relation(fields: [slaId], references: [id], onDelete: SetNull)
  links       IncidentLink[]
  validations ImpactValidation[]
  runbook     Runbook?           @relation(fields: [runbookId], references: [id], onDelete: SetNull)
  runbookRuns RunbookStepRun[]

  @@index([tenantId, state, openedAt])
  @@index([tenantId, source, state])
  @@map("incidents")
}

/// incidentLinkSchema
model IncidentLink {
  incidentId    String   @db.Uuid
  integrationId String   @db.Uuid
  tenantId      String   @db.Uuid
  remoteId      String
  remoteUrl     String?
  remoteState   String
  syncedAt      DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incident    Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  integration IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([incidentId, integrationId])
  @@index([integrationId, remoteId])
  @@map("incident_links")
}

// ---------------------------------------------------------------------------------------------
// Integrations and security
// ---------------------------------------------------------------------------------------------

/// integrationConfigSchema. vendor is a string: adding a vendor is a tracker row, not a contract change.
model IntegrationConfig {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  category         IntegrationCategory
  vendor           String
  name             String
  enabled          Boolean             @default(false)
  direction        Direction
  endpoint         String
  credentialRef    String
  settings         Json
  fieldMappings    Json
  classMappings    Json
  subscribedEvents String[]
  scheduleCron     String?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status         IntegrationStatus?
  deliveries     IntegrationDelivery[]
  incidentLinks  IncidentLink[]
  securityAlerts SecurityAlert[]

  @@unique([tenantId, name])
  @@index([tenantId, category, enabled])
  @@map("integration_configs")
}

/// integrationStatusSchema: rolling health, one row per integration.
model IntegrationStatus {
  integrationId       String            @id @db.Uuid
  health              IntegrationHealth @default(disabled)
  lastSuccessAt       DateTime?         @db.Timestamptz(3)
  lastErrorAt         DateTime?         @db.Timestamptz(3)
  lastError           String?
  credentialExpiresAt DateTime?         @db.Timestamptz(3)
  deliveredLastHour   Int               @default(0)
  failedLastHour      Int               @default(0)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  integration IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_statuses")
}

/// integrationDeliverySchema: every message to or from a remote system, for audit and replay.
model IntegrationDelivery {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  integrationId String           @db.Uuid
  direction     MessageDirection
  eventId       String?          @db.Uuid
  remoteId      String?
  state         DeliveryState    @default(pending)
  attempts      Int              @default(0)
  requestDigest String           @db.Char(64)
  responseCode  Int?
  error         String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?        @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, state, createdAt])
  @@index([tenantId, createdAt])
  @@index([eventId])
  @@map("integration_deliveries")
}

/// securityAlertSchema
model SecurityAlert {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @db.Uuid
  integrationId        String        @db.Uuid
  remoteId             String
  severity             AlertSeverity
  title                String
  observedAt           DateTime      @db.Timestamptz(3)
  /// Array of { kind, value }.
  indicators           Json
  resolvedCiIds        String[]      @db.Uuid
  affectedServiceCiIds String[]      @db.Uuid
  /// Array of { playbook, integrationId, state }.
  responseActions      Json
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, remoteId])
  @@index([tenantId, severity, observedAt])
  @@map("security_alerts")
}

// ---------------------------------------------------------------------------------------------
// Audit and user state
// ---------------------------------------------------------------------------------------------

/// Append-only record of every user and system action (openmap.audit.action). Mirrored to ClickHouse audit_log.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actor       String
  action      String
  subjectType String
  subjectId   String
  details     Json
  traceparent String?
  /// When the action happened; createdAt is when the row was written.
  at          DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
  @@index([tenantId, subjectType, subjectId])
  @@map("audit_logs")
}

/// Per-user console state: which layers are visible, locale and view preferences.
/// dashboardSchema (ADR-020): widgets is the JSON array of dashboardWidgetSchema.
model Dashboard {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  name      String
  persona   DashboardPersona
  owner     String
  shared    Boolean          @default(false)
  isDefault Boolean          @default(false)
  widgets   Json
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, owner])
  @@index([tenantId, shared])
  @@map("dashboards")
}

model UserPreference {
  tenantId      String    @db.Uuid
  userId        String
  locale        Locale?
  timeZone      String?
  visibleLayers CiLayer[]
  /// Saved views, column choices and other console state the API validates per screen.
  preferences   Json
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("user_preferences")
}

/// Relationship observations whose endpoints were not yet known when their result arrived; retried
/// after later results land (REQ-CORE-013).
model PendingRelationship {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  type              RelationshipType
  fromRef           Json
  toRef             Json
  attributes        Json
  observedAt        DateTime         @db.Timestamptz(3)
  sourceCollectorId String
  sourceNodeId      String
  sourceRunId       String
  attempts          Int              @default(0)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("pending_relationships")
}

/// REQ-AI-008 (ADR-028) — a person's conversation with the assistant. Owned by the user who asked, scoped to the
/// tenant; the title is the first question clipped. Deleting a conversation removes its turns.
model AssistantConversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String
  title     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turns  AssistantTurn[]

  @@index([tenantId, userId, updatedAt(sort: Desc)])
  @@map("assistant_conversations")
}

/// How a turn ended: answered, a clarifying question back, or every retrieval step failed.
enum AssistantTurnOutcome {
  answered
  clarified
  failed
}

/// One exchange: the question as asked and the answer as returned (assistantTurnAnswerSchema in
/// @openmap/contracts: text, intent, confidence, figures, evidence, follow-ups, clarification, grounded, CI ids and
/// the resolved reading the next turn fills its gaps from).
model AssistantTurn {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  conversationId String               @db.Uuid
  at             DateTime             @default(now()) @db.Timestamptz(3)
  outcome        AssistantTurnOutcome
  locale         Locale
  question       String
  answer         Json

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, at])
  @@map("assistant_turns")
}

enum CustomFieldType {
  text
  number
  date
  boolean
  select
}

/// REQ-CMDB-015 — a tenant-defined field on CIs (customFieldDefinitionInputSchema in @openmap/contracts). The key is
/// unique per tenant and names the value in `cis.customFields`; an empty `appliesTo` applies to every CI type.
model CustomFieldDefinition {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  key         String
  labelEn     String
  labelAr     String
  description String          @default("")
  type        CustomFieldType
  options     String[]
  appliesTo   CiType[]
  required    Boolean         @default(false)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("custom_field_definitions")
}

/// REQ-CMDB-033 REQ-CMDB-036 (ADR-032) — one import of a spreadsheet or another CMDB's export: what was read, what was
/// rejected and why, the mapping used, and the run id the queued observations carry, so the CIs it created or touched
/// can be found by their provenance.
model ImportJob {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  filename     String
  format       String
  /// Data rows read (the header excluded), observations queued, rows refused.
  rows         Int
  accepted     Int
  rejected     Int
  /// RejectedRow[] (row number and reason), capped at IMPORTS.maxRejectedShown.
  rejectedRows Json
  /// importMappingSchema.
  mapping      Json
  /// Observations per CI type.
  byType       Json
  runId        String   @db.Uuid
  submittedBy  String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("import_jobs")
}

/// REQ-CMDB-032 (ADR-036): expiry alerts raised, one per certificate, expiry date and threshold.
model CertificateAlert {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  ciId          String   @db.Uuid
  notAfter      DateTime @db.Timestamptz(3)
  thresholdDays Int
  daysLeft      Int
  eventId       String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ci     Ci     @relation(fields: [ciId], references: [id], onDelete: Cascade)

  @@unique([ciId, notAfter, thresholdDays])
  @@index([tenantId, createdAt])
  @@map("certificate_alerts")
}

/// REQ-CMDB-014 (ADR-037): parts and components of a CI, mirrored from its `components` attribute; kept after removal.
model CiComponent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  ciId          String    @db.Uuid
  kind          String
  slot          String
  model         String?
  manufacturer  String?
  serialNumber  String?
  partNumber    String?
  capacityBytes Float?
  firmware      String?
  details       Json      @default("{}")
  firstSeenAt   DateTime  @db.Timestamptz(3)
  lastSeenAt    DateTime  @db.Timestamptz(3)
  removedAt     DateTime? @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ci     Ci     @relation(fields: [ciId], references: [id], onDelete: Cascade)

  @@unique([ciId, kind, slot])
  @@index([tenantId, kind, model])
  @@index([tenantId, serialNumber])
  @@map("ci_components")
}

/// REQ-CMDB-023 REQ-CMDB-025 (ADR-039): the product lifecycle catalogue, shared by every tenant.
model LifecycleEntry {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source             String
  product            String
  cycle              String
  kind               String
  label              String
  releaseDate        DateTime? @db.Date
  supportEnd         DateTime? @db.Date
  endOfSupport       DateTime? @db.Date
  supportEnded       Boolean   @default(false)
  extendedSupportEnd DateTime? @db.Date
  latest             String?
  lts                Boolean   @default(false)
  link               String?
  fetchedAt          DateTime  @db.Timestamptz(3)

  @@unique([source, product, cycle])
  @@index([product, cycle])
  @@map("lifecycle_entries")
}
