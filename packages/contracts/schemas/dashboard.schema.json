{
  "$id": "https://openmap.dev/contracts/dashboard/1.34.0",
  "title": "dashboard",
  "version": "1.34.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "persona": {
      "type": "string",
      "enum": [
        "admin",
        "cto_cio",
        "ciso",
        "finance",
        "custom"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "shared": {
      "type": "boolean"
    },
    "isDefault": {
      "type": "boolean"
    },
    "widgets": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "estate.cis",
              "estate.layers",
              "estate.trend",
              "services.health",
              "services.sla",
              "services.uptime",
              "incidents.open",
              "impact.recent",
              "discovery.sweep",
              "discovery.nodes",
              "discovery.jobs",
              "security.vulnerabilities",
              "security.exposure",
              "software.end_of_support",
              "software.licences",
              "assets.stages",
              "assets.warranty",
              "finance.licence_cost",
              "finance.asset_value",
              "finance.plans",
              "dcim.power",
              "ipam.utilisation",
              "integrations.health",
              "audit.recent",
              "platform.settings"
            ]
          },
          "size": {
            "type": "string",
            "enum": [
              "s",
              "m",
              "l",
              "xl"
            ]
          },
          "options": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "size",
          "id"
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "tenantId",
    "name",
    "persona",
    "owner",
    "shared",
    "isDefault",
    "widgets",
    "createdAt",
    "updatedAt"
  ]
}
