{
  "$id": "https://openmap.dev/contracts/collector-job/0.6.0",
  "title": "collector-job",
  "version": "0.6.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "collectorId": {
      "type": "string",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "host",
              "cidr",
              "url",
              "cluster",
              "account",
              "zone",
              "flow_source"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "value"
        ]
      }
    },
    "credentialRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "credentialType": {
      "type": "string",
      "enum": [
        "none",
        "snmp_v2c",
        "snmp_v3",
        "password",
        "ssh_key",
        "api_token",
        "oauth_client",
        "certificate",
        "kubeconfig",
        "cloud_role",
        "service_account",
        "api_signing_key"
      ]
    },
    "timeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "requestsPerSecond": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "concurrency",
        "requestsPerSecond"
      ]
    },
    "options": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "scheduledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "jobId",
    "tenantId",
    "collectorId",
    "nodeId",
    "targets",
    "credentialRef",
    "credentialType",
    "timeoutMs",
    "rateLimit",
    "options",
    "scheduledAt",
    "contractVersion"
  ]
}
