{"nodes": [{"id": "docs_evidence_assets_register", "label": "Evidence: asset register follows the CMDB (REQ-CMDB-039/040, 2026-11-05)", "file_type": "document", "source_file": "docs/evidence/assets-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_assets_register_asset_register_per_layer", "label": "Asset register per layer (every owned CI)", "file_type": "concept", "source_file": "docs/evidence/assets-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The register lists every owned item in the CMDB rather than only a plan's BOM units; a row has a warranty only where a collector reported warrantyEnd and a provider, support only where a licence reported expiry and vendor; nothing is invented."}, {"id": "docs_evidence_assets_register_unknown_device_diagnosis", "label": "Unknown-device diagnosis rules", "file_type": "concept", "source_file": "docs/evidence/assets-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every CI in the unknown layer is diagnosed from scanner evidence (not seen for a month, power equipment answering SNMP, SNMP device needing credential, unknown app on non-standard port, no out-of-band management, web interface only) with a suggested layer and type."}, {"id": "docs_evidence_assets_register_manual_asset_entry", "label": "Record an unmanaged asset (manual entry)", "file_type": "concept", "source_file": "docs/evidence/assets-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates the CI of the chosen owned type together with the register row, for an unmetered PDU or any device without management."}, {"id": "docs_evidence_assets_register_migration_0015", "label": "Migration 0015 (asset register backfill)", "file_type": "code", "source_file": "docs/evidence/assets-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_assets_register_adr_026", "label": "ADR-026 Embedded Superset Lighthouse floor 0.65 and the question of native charts", "file_type": "document", "source_file": "docs/evidence/assets-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The embedded Superset frame's 2.7 MB of script costs about 1.5 s of blocking time on a throttled CPU whatever the console does; the ADR records the cost and the open question of native charts."}, {"id": "docs_evidence_assets_register_lighthouse_sweep_2026_11_05", "label": "Lighthouse sweep 2026-11-05 (all screens)", "file_type": "concept", "source_file": "docs/evidence/assets-register.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_evidence_assets_register", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_cmdb_039", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/assets-register.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_assets_register", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_cmdb_040", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/assets-register.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_assets_register", "target": "graphify_out_converted_openmap_tracker_d0198e2e_adr_023", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/assets-register.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_assets_register", "target": "docs_evidence_assets_register_adr_026", "relation": "references", "confidence": "E