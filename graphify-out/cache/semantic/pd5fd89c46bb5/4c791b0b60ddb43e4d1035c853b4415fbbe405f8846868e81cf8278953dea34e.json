{"nodes": [{"id": "docs_adr_adr_026_embedded_analytics_floor", "label": "ADR-026 The embedded analytics performance floor states Superset's own cost", "file_type": "document", "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_026_embedded_analytics_floor_lighthouse_embedded_performance_min", "label": "PERF_BUDGETS.lighthouseEmbeddedPerformanceMin = 0.65", "file_type": "rationale", "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-012's 0.70 floor was measured while the Superset frame still showed its spinner; fully loaded, the screen scores 0.67 three times running, with Superset's own bundles (2.7 MB over 64 requests, ~1.6 s blocking) against ~160 ms for the console's chunks. The number is the measured cost written down rather than hidden; console screens keep 0.90."}, {"id": "docs_adr_adr_026_embedded_analytics_floor_perf_only_flag", "label": "tools/perf --only <screens>", "file_type": "concept", "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-measures named screens after a fix and merges them into the last full sweep's results so one screen can be checked without the ten-minute sweep."}, {"id": "docs_adr_adr_026_embedded_analytics_floor_native_charts_question", "label": "Open question: native ClickHouse charts on the Analytics screen", "file_type": "concept", "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replacing the embedded frame with native charts is the only path to 0.90 there; goes to Syed in docs/STATE.md and REQ-UI-021/022/023 (reports, DOQL, BI) would carry it. Until then the score is Superset's to improve."}, {"id": "docs_adr_adr_026_embedded_analytics_floor_req_perf_001", "label": "REQ-PERF-001", "file_type": "concept", "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_026_embedded_analytics_floor_req_ui_017", "label": "REQ-UI-017", "file_type": "concept", "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_adr_026_embedded_analytics_floor", "target": "docs_adr_adr_026_embedded_analytics_floor_lighthouse_embedded_performance_min", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_026_embedded_analytics_floor", "target": "docs_adr_adr_026_embedded_analytics_floor_perf_only_flag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_026_embedded_analytics_floor", "target": "docs_adr_adr_026_embedded_analytics_floor_native_charts_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_026_embedded_analytics_floor", "target": "docs_adr_adr_012_remaining_console_screens", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-026-embedded-analytics-floor.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_026_embedded_analytics_floor_lighthouse_embedded_performance_min", "target"