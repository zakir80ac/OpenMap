{"nodes": [{"id": "docs_evidence_layers_stack", "label": "Evidence: Layers screen as an equipment scene and the formal profile (REQ-UI-033/034/035, ADR-021/022)", "file_type": "document", "source_file": "docs/evidence/layers-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_layers_stack_layers_equipment_scene", "label": "Layers: three.js orthographic stack of twelve planes with click-to-focus equipment", "file_type": "concept", "source_file": "docs/evidence/layers-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twelve slate planes in contract order, data centre at the bottom; clicking zooms onto a layer whose equipment is built from primitives at plausible proportions; no text inside the canvas, the visibility list is the legend and an accessible tier list mirrors the scene."}, {"id": "docs_evidence_layers_stack_formal_profile", "label": "Formal profile: holographic borders, brackets, grid floor, auroras, sheens, glows removed from packages/ui", "file_type": "concept", "source_file": "docs/evidence/layers-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removed, not switched off: Syed rejected the holographic stack as game-inspired with unreadable text, so the ADR was rewritten rather than kept."}, {"id": "docs_evidence_layers_stack_holographic_stack_rejected", "label": "Rejected first cut: holographic wafers, spinning glyphs, projected labels", "file_type": "concept", "source_file": "docs/evidence/layers-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projected two-line labels overlapped at the step size; a twelve-tile grid lost the layering sequence and left equipment at ~100 px."}, {"id": "docs_evidence_layers_stack_vendor_marks", "label": "Vendor marks (simple-icons, CC0) beside each layer row", "file_type": "concept", "source_file": "docs/evidence/layers-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_layers_stack_shared_materials_on_demand_loop", "label": "On-demand frame loop and shared materials per plane", "file_type": "concept", "source_file": "docs/evidence/layers-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A continuous frame loop scored 0.86 with 334 ms total blocking time; going on demand with shared materials reached 0.98, the same change that lifted the twin to 0.99-1.00."}], "edges": [{"source": "docs_evidence_layers_stack", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_ui_033", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/layers-stack.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_layers_stack", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_ui_034", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/layers-stack.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_layers_stack", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_ui_035", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/layers-stack.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_layers_stack", "target": "graphify_out_converted_openmap_tracker_d0198e2e_adr_021", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/layers-stack.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_layers_stack", "target": "graphify_out_converted_openmap_tracker_d0198e2e_adr_022", "relation": "references", "confide