{"nodes": [{"id": "docs_adr_adr_010_audit_log_through_the_outbox", "label": "ADR-010 Every mutation is audited through the outbox", "file_type": "document", "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_010_audit_log_through_the_outbox_audit_interceptor", "label": "Global GraphQL audit interceptor", "file_type": "rationale", "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records actor, action, subject, redacted arguments and traceparent for every successful mutation; written inside the mutation's own outbox transaction so a failed mutation leaves no audit entry and ClickHouse audit_log is fed by the reconciler dispatcher."}, {"id": "docs_adr_adr_010_audit_log_through_the_outbox_append_only_trigger", "label": "audit_logs append-only trigger (migration 0007)", "file_type": "rationale", "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A database trigger refuses UPDATE and DELETE so deleting audit rows requires dropping the trigger, which is itself a visible schema change; immutability enforced at the store rather than the application."}, {"id": "docs_adr_adr_010_audit_log_through_the_outbox_auditlog_query", "label": "Query.auditLog (GraphQL 0.2.0)", "file_type": "concept", "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Readable by openmap-auditor and openmap-admin only; auditor implies analyst so analysts cannot read it. Shown on the Settings screen beside the signed-in identity."}, {"id": "docs_adr_adr_010_audit_log_through_the_outbox_transactional_outbox", "label": "Transactional outbox", "file_type": "concept", "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_010_audit_log_through_the_outbox_openmap_audit_action_event", "label": "openmap.audit.action event", "file_type": "concept", "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_010_audit_log_through_the_outbox_req_sec_005", "label": "REQ-SEC-005", "file_type": "concept", "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_adr_010_audit_log_through_the_outbox", "target": "docs_adr_adr_010_audit_log_through_the_outbox_audit_interceptor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_010_audit_log_through_the_outbox", "target": "docs_adr_adr_010_audit_log_through_the_outbox_append_only_trigger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_010_audit_log_through_the_outbox", "target": "docs_adr_adr_010_audit_log_through_the_outbox_auditlog_query", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-010-audit-log-through-the-outbox.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_010_audit_log_through_the_outbox", "target": "docs_adr_adr_010_audit_log_through_the_outbox_req_sec_005", "relation": "implements