{"nodes": [{"id": "docs_evidence_airgap_load_airgap", "label": "Evidence: offline bundle loaded on an isolated host with egress blocked (2026-10-22)", "file_type": "document", "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_airgap_load_airgap_load_bundle_sh", "label": "load-bundle.sh (verify checksums, load images, start air-gapped profile)", "file_type": "code", "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_airgap_load_airgap_egress_blocked_dind_host", "label": "Docker-in-Docker host with iptables egress dropped", "file_type": "concept", "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A docker:28-dind container with new outbound connections dropped by iptables stands in for a clean air-gapped host; the registry lookup failing proves the stack starts with no egress."}, {"id": "docs_evidence_airgap_load_airgap_busybox_sha256sum_quiet_defect", "label": "Defect: sha256sum --quiet absent on BusyBox", "file_type": "concept", "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alpine hosts lack --quiet, so the loader now uses sha256sum -c redirected to /dev/null."}, {"id": "docs_evidence_airgap_load_airgap_realm_console_public_url_defect", "label": "Defect: realm pinned console client to localhost:3000", "file_type": "concept", "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keycloak 26 substitutes plain environment names in the realm import (${env.NAME} is rejected as an invalid URI), so the realm uses ${CONSOLE_PUBLIC_URL:...} and compose/Helm pass CONSOLE_PUBLIC_URL."}, {"id": "docs_evidence_airgap_load_airgap_turborepo_strict_env_baked_localhost_defect", "label": "Defect: console bundle baked localhost origins (Turborepo strict env)", "file_type": "concept", "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turborepo strict env mode hid the Dockerfile's sentinel values from the build, so loadEnv() defaults were compiled in; turbo.json now declares the public variables and the Dockerfile fails if the sentinels are absent."}, {"id": "docs_evidence_airgap_load_airgap_airgap_e2e_suite", "label": "E2E suite run against the air-gapped stack (10 passed)", "file_type": "concept", "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_airgap_load_airgap_e2e_setup_project_first_sign_in", "label": "Playwright setup project completes first-use password change", "file_type": "concept", "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A freshly imported realm forces a first-use password change; a setup project completes it before the locale projects start."}, {"id": "docs_evidence_airgap_load_airgap_keycloak_brute_force_single_worker", "label": "Single Playwright worker because of realm brute-force policy", "file_type": "concept", "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several workers signing into the same account within one second trip quickLoginCheckMilliSeconds and Keycloak disables the account (user_temporarily_disabled), a control working as designed; so the suite runs with one worker."}], "edges": [{"source": "docs_evidence_airgap_load_airgap", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_int_002", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_airgap_load_airgap", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_sec_003", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_airgap_load_airgap", "target": "docs_evidence_airgap_load_airgap_load_bundle_sh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_airgap_load_airgap_load_bundle_sh", "target": "docs_evidence_airgap_bundle_build_sha256sums", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_airgap_load_airgap_load_bundle_sh", "target": "docs_evidence_airgap_bundle_build_offline_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_airgap_load_airgap", "target": "docs_evidence_airgap_load_airgap_egress_blocked_dind_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/airgap/load-airgap.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_airgap_load_airgap_busybox_sha256sum_quiet_defect", "target": "docs_evidence_airgap_load_airgap_load_bundle_sh", "relation": "references", "confidence": 