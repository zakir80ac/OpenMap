{"nodes": [{"id": "docs_evidence_assistant", "label": "Evidence: Assistant NL to Cypher golden set (REQ-AI-001, 2026-11-01)", "file_type": "document", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_assistant_unbound_variable_failure", "label": "Failure: Unbound variable n copied from prompt fragments", "file_type": "concept", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The grounding prompt contained fragments (WHERE n.tenantId = $tenantId, {name:$name}) that the 1.5B model copied verbatim into queries that never bound n; the repair loop could not recover because the model repeated the fragment."}, {"id": "docs_evidence_assistant_grounding_prompt_worked_examples", "label": "grounding.ts: six complete worked examples, no fragments", "file_type": "code", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complete validated examples replace fragments so a small model has nothing partial to copy; relationship directions as stored (KNOWN_DIRECTIONS), exact health values, and a statement that measurements are not graph properties."}, {"id": "docs_evidence_assistant_deterministic_nl2cypher_pipeline", "label": "nl2cypher.ts prepareCypher: extraction, hop normalisation, tenant scoping, LIMIT", "file_type": "code", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic post-processing (reverse known hops, replace wrong type when two labels share exactly one type, add tenantId and validTo IS NULL to every bound node variable, append LIMIT) so correctness does not depend on the model."}, {"id": "docs_evidence_assistant_cypher_validator", "label": "Cypher validator naming the fix per rejection", "file_type": "concept", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejects unbound/unscoped variables, unknown parameters, labels, types, properties, backwards hops and bad health literals, each with a named fix so the repair loop gives a small model something to act on and the final refusal says why."}, {"id": "docs_evidence_assistant_health_states_contract", "label": "HEALTH_STATES / healthStateSchema in @openmap/contracts", "file_type": "code", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors the GraphQL HealthState enum so the prompt and the validator share one source; TypeScript only, no wire change."}, {"id": "docs_evidence_assistant_llm_cpu_health_check_fix", "label": "Compose llm-cpu health check moved to /health on port 8000", "file_type": "concept", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The image's default health check targeted llama.cpp's default port while the server listened on 8000; the container had been unhealthy for 499 checks."}, {"id": "docs_evidence_assistant_golden_set", "label": "Golden set: 12 of 12 questions pass", "file_type": "concept", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_assistant_measurement_refusal", "label": "Correct refusal: utilisation and power draw are not graph properties", "file_type": "concept", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measurements are served by the API from Postgres/ClickHouse (IPAM and DCIM screens), not stored as node properties, so the assistant says so instead of returning no matching items."}, {"id": "docs_evidence_assistant_qwen25_coder_1_5b_instruct", "label": "Qwen2.5-Coder-1.5B-Instruct (q4_k_m) on llama.cpp (cpu profile)", "file_type": "concept", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_assistant_console_example_prompts", "label": "Assistant screen example prompts (all answerable)", "file_type": "concept", "source_file": "docs/evidence/assistant.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two examples asking for utilisation and power draw were always refused; they now ask which subnets hold the most IP addresses and which PDUs power the most hosts."}], "edges": [{"source": "docs_evidence_assistant", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_ai_001", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/assistant.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_assistant", "target": "graphify_out_converted_openmap_tracker_d0198e2e_t_113", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/assistant.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_assistant", "target": "graphify_out_converted_openmap_tracker_d0198e2e_t_011", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/assistant.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_assistant", "target": "graphify_out_converted_openmap_tracker_d0198e2e_t_104", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidenc