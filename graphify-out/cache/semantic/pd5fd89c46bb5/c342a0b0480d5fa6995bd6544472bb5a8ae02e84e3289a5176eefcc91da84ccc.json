{"nodes": [{"id": "docs_adr_adr_009_postgres_migrations_without_prisma_cli_adr_009", "label": "ADR-009 Postgres migrations run by pg, not the Prisma CLI (Proposed)", "file_type": "document", "source_file": "docs/adr/ADR-009-postgres-migrations-without-prisma-cli.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prisma migrate deploy needs the Prisma CLI and shells out through pnpm; production images built with pnpm deploy --prod and air-gapped hosts have neither, so the compose migration job and Helm hook failed with spawnSync pnpm ENOENT."}, {"id": "docs_adr_adr_009_postgres_migrations_without_prisma_cli_native_postgres_migration_runner", "label": "packages/db/src/migrate-postgres.ts applies prisma/migrations/*/migration.sql over pg", "file_type": "concept", "source_file": "docs/adr/ADR-009-postgres-migrations-without-prisma-cli.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lexical order, one transaction per migration, recorded in Prisma's _prisma_migrations table with the same SHA-256 checksum, so prisma migrate status still reports the same applied set."}, {"id": "docs_adr_adr_009_postgres_migrations_without_prisma_cli_prisma_as_schema_language_only", "label": "Prisma remains the schema language and migration SQL generator in development; not required at runtime", "file_type": "rationale", "source_file": "docs/adr/ADR-009-postgres-migrations-without-prisma-cli.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_009_postgres_migrations_without_prisma_cli_multi_statement_migration_constraint", "label": "Multi-statement migration files run as one query; per-statement transaction control needs separate migrations", "file_type": "concept", "source_file": "docs/adr/ADR-009-postgres-migrations-without-prisma-cli.md", "source_location": null, "sourc