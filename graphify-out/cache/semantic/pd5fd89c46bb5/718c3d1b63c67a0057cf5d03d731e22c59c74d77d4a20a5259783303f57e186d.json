{"nodes": [{"id": "docs_adr_adr_012_remaining_console_screens", "label": "ADR-012 Integrations detail, embedded analytics, rack placement (0.4.0)", "file_type": "document", "source_file": "docs/adr/ADR-012-remaining-console-screens.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_012_remaining_console_screens_integration_detail", "label": "IntegrationDetail / IntegrationDelivery queries", "file_type": "concept", "source_file": "docs/adr/ADR-012-remaining-console-screens.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_012_remaining_console_screens_analytics_embed", "label": "AnalyticsEmbed / Query.analyticsEmbed", "file_type": "concept", "source_file": "docs/adr/ADR-012-remaining-console-screens.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mints a five-minute Superset guest token whose row-level-security clause pins tenant_id, so the browser only ever sees a tenant-scoped session."}, {"id": "docs_adr_adr_012_remaining_console_screens_superset_provisioner", "label": "Superset estate dashboard provisioner", "file_type": "rationale", "source_file": "docs/adr/ADR-012-remaining-console-screens.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provisions database, datasets, charts, dashboard, embedding and guest-role permissions once through Superset's own REST API; chart definitions are code in the API, versioned with it, re-provisioned on next start. Superset is a runtime dependency of the analytics screen only; the API degrades to an explicit error when it is unreachable."}, {"id": "docs_adr_adr_012_remaining_console_screens_superset_embedded_sdk", "label": "@superset-ui/embedded-sdk", "file_type": "concept", "source_file": "docs/adr/ADR-012-remaining-console-screens.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because it is the SDK the Superset project ships for embedding (Apache-2.0) and Superset is already in the stack, so no new component."}, {"id": "docs_adr_adr_012_remaining_console_screens_dcim_attributes", "label": "DCIM_ATTRIBUTES contract constant", "file_type": "concept", "source_file": "docs/adr/ADR-012-remaining-console-screens.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attribute conventions (heightU, uPosition, PDUs located in rack) moved into packages/contracts so collectors, the synthetic estate and the API agree; previously the API read names nothing emitted."}, {"id": "docs_adr_adr_012_remaining_console_screens_rack_placement", "label": "Rack.row / Rack.room placement", "file_type": "concept", "source_file": "docs/adr/ADR-012-remaining-console-screens.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_012_remaining_console_screens_ipam_identity_cidr", "label": "IPAM reads cidr and vrfRef from identity", "file_type": "rationale", "source_file": "docs/adr/ADR-012-remaining-console-screens.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The contract's identity keys name cidr and vrfRef as identity, not attributes; reading them from attributes made discovered subnets invisible."}], "edges": [{"source": "docs_adr_adr_012_remaining_console_screens", "target": "docs_adr_adr_012_remaining_console_screens_integration_detail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-012-remaining-console-screens.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_012_remaining_console_screens", "target": "docs_adr_adr_012_remaining_console