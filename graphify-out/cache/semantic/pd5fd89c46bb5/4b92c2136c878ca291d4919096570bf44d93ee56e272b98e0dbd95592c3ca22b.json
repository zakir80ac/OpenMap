{"nodes": [{"id": "docs_adr_adr_006_node_pki_library_adr_006", "label": "ADR-006 @peculiar/x509 for Node certificate issuance (Proposed)", "file_type": "document", "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "node:crypto can parse but not create or sign X.509; shelling out to openssl would make the scheduler depend on a binary outside the compose image."}, {"id": "docs_adr_adr_006_node_pki_library_peculiar_x509", "label": "@peculiar/x509 (MIT, pure TypeScript over WebCrypto) in apps/scheduler", "file_type": "concept", "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sovereign (no network calls) and air-gap safe; one new runtime dependency not in SPEC.md's component table, hence the ADR."}, {"id": "docs_adr_adr_006_node_pki_library_mtls_enrolment_csr_signing", "label": "Node enrolment: one-time token plus CSR signed by the scheduler's internal CA", "file_type": "concept", "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys ECDSA P-256, SHA-256 signatures, 16 random-byte serials, clientAuth EKU, validity NODE_CERT_VALIDITY_DAYS default 90, CA key at SCHEDULER_CA_KEY_PATH."}, {"id": "docs_adr_adr_006_node_pki_library_pki_init_cli", "label": "pnpm --filter @openmap/scheduler pki:init bootstraps a CA and server certificate", "file_type": "concept", "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_006_node_pki_library_openssl_subprocess_alternative", "label": "Alternative: openssl subprocess", "file_type": "rationale", "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: adds an image dependency and shell quoting risk."}, {"id": "docs_adr_adr_006_node_pki_library_openbao_pki_engine_upgrade_path", "label": "Alternative: step-ca or OpenBao PKI secrets engine", "file_type": "rationale", "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Better long term for rotation and CRLs; natural upgrade path keeping the same enrolment API; deferred until the single-node release is stable."}], "edges": [{"source": "docs_adr_adr_006_node_pki_library_adr_006", "target": "docs_adr_adr_006_node_pki_library_peculiar_x509", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_006_node_pki_library_adr_006", "target": "docs_adr_adr_006_node_pki_library_mtls_enrolment_csr_signing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_006_node_pki_library_adr_006", "target": "docs_adr_adr_006_node_pki_library_pki_init_cli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_006_node_pki_library_adr_006", "target": "docs_adr_adr_006_node_pki_library_openssl_subprocess_alternative", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-006-node-pki-library.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_006_node_pki_library_adr_006", "target": "docs_adr_adr_006_node_pki_library_openbao_pki_engine_upgrade_path", "