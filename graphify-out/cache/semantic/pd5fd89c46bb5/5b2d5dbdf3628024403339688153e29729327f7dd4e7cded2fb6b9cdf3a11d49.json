{"nodes": [{"id": "claude_openmap", "label": "OpenMap", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sovereign open-source replacement for Device42: discovery, dependency mapping, CMDB, IPAM/DNS/DHCP, DCIM, software/licence, vulnerability correlation, BSM, time travel, embedded Superset, AI assistant. One release, no phases."}, {"id": "claude_no_hardcoding", "label": "No hardcoding rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a71.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every host, port, URL, path, credential, threshold, colour, label, model name comes from packages/config (zod-validated env), tenant settings in the DB, or packages/constants. A literal that could differ between deployments is a bug."}, {"id": "claude_fully_functional_no_dummy", "label": "Fully functional, no dummy sections", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a71.2-1.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No TODO/placeholder/mock in apps/ or packages/; every screen, endpoint, collector, job and report works end to end against the real compose stack."}, {"id": "claude_sovereign_by_default", "label": "Sovereign by default", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a71.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No outbound network call at runtime except collectors to their targets and tenant-enabled integrations; the air-gapped compose profile must pass the full e2e suite."}, {"id": "claude_open_source_only", "label": "Open source only, no product dependency", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a71.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GPL/AGPL components run as separate processes, never linked; IPAM, DCIM and BSM are built in rather than delegated to NetBox, Grafana or an ITSM."}, {"id": "claude_i18n_rtl_first_commit", "label": "Arabic/RTL and English from first commit", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a71.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No user-facing string in code; every string is an i18n key with both locales filled so RTL is never retrofitted."}, {"id": "claude_project_memory", "label": "Project memory files", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLAUDE.md, STATE.md, the tracker, GRAPH_REPORT.md, SPEC.md, ADRs and CONTRACTS.md are read at session start and written at session end so context is never lost; if STATE.md and tracker disagree the tracker wins."}, {"id": "claude_tracker", "label": "OpenMap-Tracker.xlsx", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only edited through tools/tracker (ExcelJS CLI, pnpm tracker); no requirement exists unless it is a row; pnpm tracker verify blocks merges when a Done row lacks tests and evidence."}, {"id": "claude_graphify_knowledge_graph", "label": "graphify knowledge graph", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structural memory of the codebase; docs/ is inside the graph so SPEC, ADRs and STATE link requirements to the code that implements them; REQ ids in commit messages and file headers form the links."}, {"id": "claude_repository_layout", "label": "Fixed repository layout", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_definition_of_done", "label": "Definition of Done", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merged on main, unit+integration+e2e+k6 tests with IDs in the tracker, guard passes, en+ar keys with RTL screenshot, contracts bumped via ADR, OTel spans and Prometheus metric, works in airgap profile, STATE and graph refreshed."}, {"id": "claude_guard", "label": "pnpm guard (tools/guard)", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fails the build on forbidden tokens, any-casts, literal IPs/URLs/ports outside config, magic numbers in apps/, user-facing string literals in the console, files without a REQ header, and Done rows without evidence."}, {"id": "claude_contracts_first", "label": "Contracts first", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REQ-CORE-001\u2026010 freeze packages/contracts before any other workstream starts, so parallel subagents per workstream can build against a stable CI schema, collector schema, GraphQL schema and event schema."}, {"id": "claude_synth_estate", "label": "tools/synth-estate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic 100k-CI estate generator replayed through the real collector contract; a generator exercising the real pipeline, explicitly not a mock."}, {"id": "claude_performance_targets", "label": "Performance targets", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "p95 under 100 ms per screen interaction, under 1 s for a 100k-node impact query, 60 fps graph rendering, 10k devices discovered in under 15 minutes; performance is a tracked requirement, not a tuning pass."}, {"id": "claude_session_rituals", "label": "Session start and end rituals", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_spec_md", "label": "docs/SPEC.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source of truth for scope and architecture; wins over CLAUDE.md on disagreement."}, {"id": "claude_state_md", "label": "docs/STATE.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_contracts_md", "label": "docs/CONTRACTS.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_coding_standards", "label": "Coding standards", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TS strict + noUncheckedIndexedAccess; Go 1.23 with slog; NestJS one module per bounded context with outbox for every cross-store write; Next.js server components by default, TanStack Virtual lists, Sigma.js in a Web Worker; design tokens only."}], "edges": [{"source": "claude_no_hardcoding", "target": "claude_openmap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE