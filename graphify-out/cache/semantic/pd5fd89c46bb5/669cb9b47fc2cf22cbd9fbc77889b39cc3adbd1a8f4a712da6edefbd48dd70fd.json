{"nodes": [{"id": "docs_evidence_horizon_twin", "label": "Evidence: Horizon visual language and the 3D digital twin (REQ-UI-028/029, ADR-018)", "file_type": "document", "source_file": "docs/evidence/horizon-twin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_horizon_twin_horizon_visual_language", "label": "Horizon visual language: display face, holographic borders, grid ground, HUD brackets, motion", "file_type": "concept", "source_file": "docs/evidence/horizon-twin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All of it comes from packages/ui tokens and stylesheet rules the console injects, so sixteen screens inherited it without per-screen edits; prefers-reduced-motion stops every animation."}, {"id": "docs_evidence_horizon_twin_digital_twin_scene", "label": "/twin: rooms as glass slabs, instanced racks coloured by power, device plates, focus graph on layer planes", "file_type": "concept", "source_file": "docs/evidence/horizon-twin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-only chunk loaded after the page paints, renders on demand, device pixel ratio capped at 1.5."}, {"id": "docs_evidence_horizon_twin_no_fcp_opacity_rise_defect", "label": "Defect: Lighthouse NO_FCP because every card rose from opacity 0", "file_type": "concept", "source_file": "docs/evidence/horizon-twin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrome never recorded a first contentful paint on a page that is all cards; a probe with prefers-reduced-motion scored 0.99 which pinned it on the animation, so the rise now moves without fading."}, {"id": "docs_evidence_horizon_twin_on_demand_render_loop", "label": "Twin renders on demand (no frame without input)", "file_type": "concept", "source_file": "docs/evidence/horizon-twin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_horizon_twin_layer_planes_focus_graph", "label": "Focus CI dependency graph on stacked planes in CI_LAYERS order", "file_type": "concept", "source_file": "docs/evidence/horizon-twin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The impact query at depth six returns 1,707 nodes for a host OS; a per-plane grid keeps that readable and one lineSegments batch keeps it one draw call. The 2D lane positions were tried first and put a layer's nodes on one 3 km line."}, {"id": "docs_evidence_horizon_twin_entrance_rise_fill_mode_backwards", "label": "Entrance rise uses fill-mode backwards", "file_type": "concept", "source_file": "docs/evidence/horizon-twin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dropdowns inside cards painted under following cards when the animation left a transform behind."}, {"id": "docs_evidence_horizon_twin_perf_tool_prints_runtime_error", "label": "Perf tool prints Lighthouse runtime error and audit warnings for screens under budget", "file_type": "concept", "source_file": "docs/evidence/horizon-twin.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_evidence_horizon_twin", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_ui_028", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/horizon-twin.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_horizon_twin", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_ui_029", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/horizon-twin.m