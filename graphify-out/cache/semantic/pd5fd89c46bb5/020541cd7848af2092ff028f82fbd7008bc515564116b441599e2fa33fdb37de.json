{"nodes": [{"id": "tools_synth_estate_readme_synth_estate_generator", "label": "@openmap/synth-estate deterministic synthetic estate generator (REQ-QA-001)", "file_type": "document", "source_file": "tools/synth-estate/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A generator of production-shaped data, not a test double: output goes through the same ingest path a Discovery Node uses, so every module runs against the same 100k-CI graph the budgets are measured on."}, {"id": "tools_synth_estate_readme_seeded_xoshiro128_streams", "label": "Seeded xoshiro128** streams (src/rng.ts) forked once per generator in a fixed order", "file_type": "rationale", "source_file": "tools/synth-estate/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forking per generator means adding a CI type to one generator does not reshuffle the others; same seed and scale produce byte-identical NDJSON, asserted by SHA-256 digests of two runs."}, {"id": "tools_synth_estate_readme_horizon_bank_estate", "label": "Horizon Bank estate: 4 business units, RYD/JED/DMM-COLO/HQ/212 branches/Azure UAE North/AWS me-south-1", "file_type": "concept", "source_file": "tools/synth-estate/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tools_synth_estate_readme_estate_shape_scale_1", "label": "Scale 1: ~5,000 network devices, 40,000 hosts, 30,000 VMs, 6 k8s clusters, ~360 applications, 300 business services, ~320 CVEs", "file_type": "concept", "source_file": "tools/synth-estate/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts scale linearly (round(base x scale), minimum 1); structural minimums keep tiny estates topologically sound."}, {"id": "tools_synth_estate_readme_ndjson_per_collector_family",