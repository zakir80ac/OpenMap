{"nodes": [{"id": "docs_adr_adr_028_conversational_assistant_adr_028", "label": "ADR-028 Ask becomes a conversation", "file_type": "document", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "Syed's 2026-11-05 review: Ask was one question to one Cypher statement over Memgraph only, with no server-side conversation state and a 1.5B model copying prompt fragments; measurements in ClickHouse and attributes in Postgres were out of reach."}, {"id": "docs_adr_adr_028_conversational_assistant_syed_review_2026_11_05", "label": "Syed review 2026-11-05: Ask chat is dumb", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null}, {"id": "docs_adr_adr_028_conversational_assistant_conversation_record", "label": "A conversation is a record", "file_type": "rationale", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "Persisting turns per user lets a follow-up resolve against the previous turn's entities and period; one row per exchange holds question and answer, so the column is outcome (answered, clarified, failed) rather than role."}, {"id": "docs_adr_adr_028_conversational_assistant_five_levels", "label": "Five levels: understand, plan, retrieve, compose, follow up", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "Deterministic where it matters: the classifier, the planner and the follow-ups are deterministic; the LLM is only a low-confidence fallback and a prose rewriter under a guard."}, {"id": "docs_adr_adr_028_conversational_assistant_intent_classifier", "label": "Bilingual intent classifier with clarifications", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "An ambiguous CMDB match becomes a clarifying question, not a guess; the LLM fills gaps below a confidence floor but never overrides."}, {"id": "docs_adr_adr_028_conversational_assistant_grounding_guard", "label": "Grounding guard on model prose", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "Every number in the prose must occur in the results and every CI named must be in the evidence, otherwise the sentence is replaced by the deterministic summary; needed because the CPU-profile model copies prompt fragments verbatim."}, {"id": "docs_adr_adr_028_conversational_assistant_follow_up_resolution", "label": "Deterministic follow-up resolution", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "A continuation opener or a short fragment inherits what it left out from the previous turn's persisted reading; the intent is re-derived from merged entities; a new subject type drops names and scope and carries a measurement to its equivalent metric."}, {"id": "docs_adr_adr_028_conversational_assistant_rolling_window_for_measurements", "label": "Calendar period on a measurement read as a rolling window", "file_type": "rationale", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "Measurements are sampled, not booked to calendar months as availability is, so 'CPU last month' becomes a window of ASSISTANT.rollingDays."}, {"id": "docs_adr_adr_028_conversational_assistant_evaluation_set", "label": "Evaluation set in CI (trained for OpenMap)", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "Trained for OpenMap means a catalogue generated from the contracts, worked examples per skill and a checked-in question set with an accuracy floor, not model weights; failures are events so the catalogue grows from real questions."}, {"id": "docs_adr_adr_028_conversational_assistant_lora_fine_tuning", "label": "LoRA fine-tuning on the evaluation set (documented next step)", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "Qwen2.5-7B on the GPU profile once a GPU host exists; the first increment does not depend on it."}, {"id": "docs_adr_adr_028_conversational_assistant_skill_graph_query", "label": "Skill graph.query (NL to Cypher, kept)", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null}, {"id": "docs_adr_adr_028_conversational_assistant_skill_cmdb_attributes", "label": "Skill cmdb.attributes (Postgres aggregates)", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null, "rationale": "The two reported failures become skill cases: 'OS per server' groups hosts by os, 'VMs per host in VMware' aggregates over runs_on with the average in SQL, never in nested Cypher."}, {"id": "docs_adr_adr_028_conversational_assistant_skill_metrics_latest", "label": "Skill metrics.latest (ClickHouse latest sample)", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null}, {"id": "docs_adr_adr_028_conversational_assistant_skill_metrics_series", "label": "Skill metrics.series (ClickHouse rolling window)", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null}, {"id": "docs_adr_adr_028_conversational_assistant_skill_services_availability", "label": "Skill services.availability", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null}, {"id": "docs_adr_adr_028_conversational_assistant_skill_incidents", "label": "Skill incidents", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null}, {"id": "docs_adr_adr_028_conversational_assistant_skill_impact", "label": "Skill impact", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null}, {"id": "docs_adr_adr_028_conversational_assistant_skill_history", "label": "Skill history (ci_history)", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor": null}, {"id": "docs_adr_adr_028_conversational_assistant_skill_howto", "label": "Skill howto (screen catalogue)", "file_type": "concept", "source_file": "docs/adr/ADR-028-conversational-assistant.md", "source_location": null, "source_url": null, "author": null, "captured_at": null, "contributor