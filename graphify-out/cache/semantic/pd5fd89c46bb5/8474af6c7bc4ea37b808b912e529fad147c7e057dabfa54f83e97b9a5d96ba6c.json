{"nodes": [{"id": "docs_adr_adr_014_ci_short_codes", "label": "ADR-014 CI short codes in the contract (GraphQL 0.6.0)", "file_type": "document", "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_014_ci_short_codes_cicode", "label": "ciCode() in packages/contracts", "file_type": "concept", "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops a dotted tail only when it contains a letter (domain suffix), so 10.0.0.1 becomes NET-10-0-0-1 rather than every IP collapsing to NET-10; published shape is CI_CODE_PATTERN."}, {"id": "docs_adr_adr_014_ci_short_codes_ci_code_pattern", "label": "CI_CODE_PATTERN", "file_type": "concept", "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_014_ci_short_codes_postgres_uniqueness_trigger", "label": "Postgres owns CI code uniqueness (migration 0010)", "file_type": "rationale", "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A BEFORE INSERT OR UPDATE OF code trigger appends the next free numeric suffix and a partial unique index on (tenantId, code) WHERE validTo IS NULL guarantees the invariant. Row-level BEFORE triggers see rows inserted earlier by the same statement, so the reconciler's array-based batch inserts stay single statements; the reconciler reads stored codes back so outbox events carry the code Postgres kept. Codes already spoken in incidents keep their value: only later duplicates are renumbered."}, {"id": "docs_adr_adr_014_ci_short_codes_setcicode", "label": "Mutation.setCiCode / Ci.code", "file_type": "concept", "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validates pattern, upper-cases input, refuses a code another current CI holds (409), emits openmap.ci.updated with changed: ['code'] so every store follows."}, {"id": "docs_adr_adr_014_ci_short_codes_openmap_ci_updated_event", "label": "openmap.ci.updated event", "file_type": "concept", "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_014_ci_short_codes_req_cmdb_037", "label": "REQ-CMDB-037", "file_type": "concept", "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_adr_014_ci_short_codes", "target": "docs_adr_adr_014_ci_short_codes_cicode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_014_ci_short_codes_cicode", "target": "docs_adr_adr_014_ci_short_codes_ci_code_pattern", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_014_ci_short_codes", "target": "docs_adr_adr_014_ci_short_codes_postgres_uniqueness_trigger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_014_ci_short_codes", "target": "docs_adr_adr_014_ci_short_codes_setcicode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-014-ci-short-codes.md", "source_location": null, "weight": 1.0}, {"sour