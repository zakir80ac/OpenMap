{"nodes": [{"id": "docs_adr_adr_022_formal_profile", "label": "ADR-022 The formal profile: Horizon without the game-like effects", "file_type": "document", "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_022_formal_profile_formal_profile", "label": "Formal profile", "file_type": "concept", "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Syed judged the Horizon ornament (holographic borders, HUD brackets, drifting grid floor, aurora washes, sheens, rings, glowing figures, entrance rise) 'game inspired'; the dark navy ground, glass surfaces, Sora and the accent palette stay, the ornament goes. Removing animation means Lighthouse budgets can only improve."}, {"id": "docs_adr_adr_022_formal_profile_float_only_effects", "label": "effects.ts keeps only float", "file_type": "rationale", "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holographic border, bracket, grid, aurora, sheen, rise, ring and value-glow tokens, CSS variables, keyframes and rules are removed, not switched off, so no screen can turn them back on by accident. Future ornament must be a token in effects.ts with a reason, used by a rule, never a one-off in a component."}, {"id": "docs_adr_adr_022_formal_profile_glow_on_request", "label": "Glow is on request (Pill/Bar glowing=false)", "file_type": "rationale", "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dot keeps its opacity pulse for live states and loses the ring; sparklines and donuts draw without drop shadows; the twin's holographic edge glow and the dashboard's float tiles are the only things that still lift."}, {"id": "docs_adr_adr_022_formal_profile_req_ui_034", "label": "REQ-UI-034", "file_type": "concept", "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_adr_022_formal_profile", "target": "docs_adr_adr_022_formal_profile_formal_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_022_formal_profile_float_only_effects", "target": "docs_adr_adr_022_formal_profile_formal_profile", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_022_formal_profile_glow_on_request", "target": "docs_adr_adr_022_formal_profile_formal_profile", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_022_formal_profile_float_only_effects", "target": "docs_adr_adr_018_three_js_digital_twin_effects_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_022_formal_profile_float_only_effects", "target": "docs_adr_adr_020_dashboards_and_role_templates_om_float", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-022-formal-profile.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_022_formal_profile_formal_profile", "target": "docs_adr_adr_018_three_js_digital_twin_horizon_visual_language", "relation": "references", "confidence": "EXTRACTED", "confi