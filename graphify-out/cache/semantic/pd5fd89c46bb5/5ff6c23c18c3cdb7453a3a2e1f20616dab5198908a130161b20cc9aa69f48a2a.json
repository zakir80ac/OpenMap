{"nodes": [{"id": "docs_evidence_cmdb_headline_metrics", "label": "Evidence: headline metric per layer on cards and tables (REQ-CMDB-038, ADR-016)", "file_type": "document", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_cmdb_headline_metrics_metric_samples_in_collector_result", "label": "Collector result samples (collector contract 0.2.0)", "file_type": "concept", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_cmdb_headline_metrics_openmap_metric_sampled_event", "label": "openmap.metric.sampled event (<= RECONCILER.samplesPerEvent samples, ClickHouse only)", "file_type": "concept", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reconciler resolves CI references, drops the rest and chunks samples into events pending for ClickHouse only; openmap_reconciler_metric_samples_total{outcome} counts stored and dropped."}, {"id": "docs_evidence_cmdb_headline_metrics_metrics_latest_mv", "label": "ClickHouse metrics_latest_mv (migration 0003) keeps metrics_latest current", "file_type": "code", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_cmdb_headline_metrics_ci_headlinemetric_batch_loader", "label": "Ci.headlineMetric per-request batch loader (GraphQL 0.8.0)", "file_type": "concept", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One metrics_latest IN query per page inside an OpenTelemetry span, counted by openmap_clickhouse_queries_total{query=headline_metrics}, keeps the page inside the 100 ms budget."}, {"id": "docs_evidence_cmdb_headline_metrics_console_headline_metric_column", "label": "Console headline metric on CMDB rows, CI detail, search hits, impact panel", "file_type": "concept", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_evidence_cmdb_headline_metrics_persist_transaction_timeout", "label": "RECONCILER.persistTransactionTimeoutMs two-minute budget", "file_type": "concept", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prisma's default five-second interactive transaction expired on a 2,000-CI result, so the persist transaction gets an explicit two-minute budget."}, {"id": "docs_evidence_cmdb_headline_metrics_power_by_rack_hourly_gap", "label": "power_by_rack_hourly stays empty: labels carry rack name not id", "file_type": "concept", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The view keys on toUUID(labels['rack_id']) but a collector only knows the rack's name, so PDU samples carry labels['rack'] until the reconciler resolves CI references inside labels (follow-up in STATE.md)."}, {"id": "docs_evidence_cmdb_headline_metrics_ci_summary_metric_fields_split", "label": "CI_SUMMARY_FIELDS lean; CI_SUMMARY_METRIC_FIELDS selected only where shown", "file_type": "concept", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selecting the metric in the shared CI summary made every list pay the ClickHouse hop and dropped DCIM racks to 0.87 Lighthouse against the 0.9 budget; the metric fields are now selected only by the CMDB list, search hits, impact root and CI detail."}, {"id": "docs_evidence_cmdb_headline_metrics_per_type_headline_override", "label": "Follow-up: per-type headline override (subnet -> utilisation)", "file_type": "concept", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The headline is per layer, so subnets and IP addresses in network_security show device traffic; a per-type override would read better and needs only a contract addition."}, {"id": "docs_evidence_cmdb_headline_metrics_replay_scale_005", "label": "Synthetic estate replay at scale 0.05 (28,203 CIs, 28,501 samples)", "file_type": "concept", "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_evidence_cmdb_headline_metrics", "target": "graphify_out_converted_openmap_tracker_d0198e2e_req_cmdb_038", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_cmdb_headline_metrics", "target": "graphify_out_converted_openmap_tracker_d0198e2e_adr_016", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_cmdb_headline_metrics_metric_samples_in_collector_result", "target": "graphify_out_converted_openmap_tracker_d0198e2e_contract_collector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evidence/cmdb/headline-metrics.md", "source_location": null, "weight": 1.0}, {"source": "docs_evidence_cmdb_headline_metrics_metric_samples_in_collector_result", "target": "docs_evidence_cmd