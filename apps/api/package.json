  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^24.10.0",
    "neo4j-driver": "^5.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
