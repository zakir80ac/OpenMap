{
  "name": "@openmap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/mercurius": "^13.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@clickhouse/client": "^1.24.0",
    "@openmap/assistant": "workspace:*",
    "@openmap/bsm-engine": "workspace:*",
    "@openmap/config": "workspace:*",
    "@openmap/constants": "workspace:*",
    "@openmap/contracts": "workspace:*",
    "@openmap/db": "workspace:*",
    "@openmap/graph": "workspace:*",
    "@openmap/i18n": "workspace:*",
    "@openmap/scheduler": "workspace:*",
    "@openmap/telemetry": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "fastify": "^5.11.0",
    "graphql": "^16.11.0",
    "jose": "^6.1.0",
    "mercurius": "^16.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
