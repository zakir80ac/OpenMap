{
  "name": "@openmap/bsm-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@openmap/config": "workspace:*",
    "@openmap/constants": "workspace:*",
    "@openmap/contracts": "workspace:*",
    "@openmap/db": "workspace:*",
    "@openmap/graph": "workspace:*",
    "@openmap/telemetry": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "bullmq": "^5.56.0",
    "ioredis": "^5.6.1",
    "prom-client": "^15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "tsx": "^4.20.0"
  }
}
