<!-- REQ-CORE-014: ClickHouse serves its own metrics for the compose Prometheus (job "clickhouse", port 9363). -->
<clickhouse>
  <prometheus>
    <endpoint>/metrics</endpoint>
    <port>9363</port>
    <metrics>true</metrics>
    <events>true</events>
    <asynchronous_metrics>true</asynchronous_metrics>
    <errors>true</errors>
  </prometheus>
</clickhouse>
