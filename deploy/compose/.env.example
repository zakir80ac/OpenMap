# Copy to .env next to docker-compose.yml. Every value mirrors a documented default in packages/config/src/env.ts.
POSTGRES_USER=openmap
POSTGRES_PASSWORD=openmap
POSTGRES_DB=openmap
POSTGRES_PORT=5432
# ADR-068: host-side tools and tests reach PostgreSQL over TLS only. Export the internal services CA once:
#   docker run --rm -v openmap_service-ca:/ca:ro alpine cat /ca/services-ca.crt > .local/services-ca.crt
POSTGRES_URL="postgresql://openmap:openmap@localhost:5432/openmap?sslmode=require&sslcert=<path>/services-ca.crt&sslaccept=strict&connect_timeout=30&connection_limit=5&pool_timeout=30"
POSTGRES_SHM_SIZE=1g
MEMGRAPH_PORT=7687
CLICKHOUSE_DB=openmap
CLICKHOUSE_USER=openmap
CLICKHOUSE_PASSWORD=openmap
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
VALKEY_PORT=6379
MEILI_MASTER_KEY=openmap-dev-master-key
MEILI_PORT=7700
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
# REQ-SEC-011 (ADR-067): OpenBao runs in server mode; services use AppRole. OPENBAO_TOKEN is only for an operator
# or host-side tests (the initial root token is in the openbao-init volume: move it offline once settled).
OPENBAO_PORT=8200
SUPERSET_SECRET_KEY=openmap-dev-superset-secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_PORT=8088
# Production default; a laptop can run Qwen/Qwen2.5-Coder-1.5B-Instruct (qwen2.5-coder-1.5b-instruct-q4_k_m.gguf) with weaker answers.
LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
LLM_GGUF=qwen2.5-coder-7b-instruct-q4_k_m.gguf
LLM_MODELS_DIR=./models
LLM_PORT=8000
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
PUBLIC_SCHEDULER_URL=https://localhost:4200
SCHEDULER_TLS_EXTRA_SANS=localhost
# REQ-IPAM-003: the lab DNS server's TSIG secret (base64, 32 random bytes): openssl rand -base64 32
DNS_LAB_TSIG_SECRET=
