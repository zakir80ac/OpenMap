<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- REQ-DISC-004 — launchd daemon for the host agent on macOS. Settings are read from /etc/openmap/agent/agent.env
     by the agent itself (OPENMAP_AGENT_ENV_FILE), so this file carries no site-specific values. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openmap.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/openmap/bin/openmap-agent</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/var/log/openmap-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/openmap-agent.log</string>
</dict>
</plist>
