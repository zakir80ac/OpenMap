{{/* REQ-INT-003 — naming, labels and the shared application environment. */}}
{{- define "openmap.name" -}}
{{- .Chart.Name -}}
{{- end -}}

{{- define "openmap.fullname" -}}
{{- printf "%s" .Release.Name | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{- define "openmap.labels" -}}
app.kubernetes.io/name: {{ include "openmap.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version }}
{{- end -}}

{{- define "openmap.componentLabels" -}}
{{ include "openmap.labels" .root }}
app.kubernetes.io/component: {{ .component }}
{{- end -}}

{{- define "openmap.selector" -}}
app.kubernetes.io/name: {{ include "openmap.name" .root }}
app.kubernetes.io/instance: {{ .root.Release.Name }}
app.kubernetes.io/component: {{ .component }}
{{- end -}}

{{- define "openmap.image" -}}
{{- $tag := default .root.Chart.AppVersion .root.Values.image.tag -}}
{{- if .root.Values.image.registry -}}
{{ printf "%s/%s/%s:%s" .root.Values.image.registry .root.Values.image.repositoryPrefix .app $tag }}
{{- else -}}
{{ printf "%s/%s:%s" .root.Values.image.repositoryPrefix .app $tag }}
{{- end -}}
{{- end -}}

{{- define "openmap.svc" -}}
{{ printf "%s-%s" (include "openmap.fullname" .root) .component }}
{{- end -}}

{{/* REQ-SEC-011 (ADR-067): OpenBao's address, the chart's own or the external vault. */}}
{{- define "openmap.vaultAddr" -}}
{{- if .Values.openbao.external.enabled }}{{ .Values.openbao.external.address }}{{ else }}https://{{ include "openmap.fullname" . }}-openbao:8200{{ end }}
{{- end }}

{{/*
ADR-068: OpenBao's listener certificate and its CA, generated by the chart and kept in a Secret across upgrades until
openbao.tls.renewDays before it expires. Returns the Secret's data as YAML (ca.crt, tls.crt, tls.key) and its expiry.
*/}}
{{- define "openmap.openbaoTls" -}}
{{- $name := printf "%s-openbao-tls" (include "openmap.fullname" .) }}
{{- $existing := lookup "v1" "Secret" .Release.Namespace $name }}
{{- $keep := false }}
{{- if and $existing $existing.metadata.annotations }}
{{- $notAfter := index $existing.metadata.annotations "openmap.io/not-after" | default "" }}
{{- if $notAfter }}
{{- $limit := now | dateModify (printf "+%dh" (mul 24 (int .Values.openbao.tls.renewDays))) | unixEpoch | int64 }}
{{- if gt (toDate "2006-01-02T15:04:05Z07:00" $notAfter | unixEpoch | int64) $limit }}{{ $keep = true }}{{ end }}
{{- end }}
{{- end }}
{{- if $keep }}
notAfter: {{ index $existing.metadata.annotations "openmap.io/not-after" | quote }}
ca.crt: {{ index $existing.data "ca.crt" | quote }}
tls.crt: {{ index $existing.data "tls.crt" | quote }}
tls.key: {{ index $existing.data "tls.key" | quote }}
{{- else }}
{{- $svc := include "openmap.svc" (dict "root" . "component" "openbao") }}
{{- $ca := genCA "OpenMap OpenBao Bootstrap CA" (int .Values.openbao.tls.days) }}
{{- $cert := genSignedCert $svc (list "127.0.0.1") (list $svc (printf "%s.%s" $svc .Release.Namespace) (printf "%s.%s.svc" $svc .Release.Namespace) "localhost") (int .Values.openbao.tls.days) $ca }}
notAfter: {{ now | dateModify (printf "+%dh" (mul 24 (int .Values.openbao.tls.days))) | date "2006-01-02T15:04:05Z07:00" | quote }}
ca.crt: {{ $ca.Cert | b64enc | quote }}
tls.crt: {{ $cert.Cert | b64enc | quote }}
tls.key: {{ $cert.Key | b64enc | quote }}
{{- end }}
{{- end -}}

{{/*
REQ-SEC-011 (ADR-068): the internal services CA for clients. An init container fetches it from OpenBao's public
pki/ca/pem (it exists once the OpenBao init job has run) into a memory volume every container of the pod mounts.
*/}}
{{- define "openmap.serviceCaInit" -}}
- name: service-ca
  image: {{ if .Values.image.registry }}{{ .Values.image.registry }}/{{ end }}{{ .Values.openbao.image }}
  imagePullPolicy: {{ .Values.image.pullPolicy }}
  {{- if .Values.openbao.external.enabled }}
  command: ["sh", "-c", "until bao read -field=certificate pki/cert/ca > /run/openmap/ca/services-ca.crt && grep -q CERTIFICATE /run/openmap/ca/services-ca.crt; do sleep {{ .Values.migrate.pollSeconds }}; done{{ if .Values.openbao.external.caBundle }}; cat /run/openmap/openbao-ca/ca.crt >> /run/openmap/ca/services-ca.crt{{ end }}"]
  {{- else }}
  # ADR-068: OpenBao's listener verified against its chart-made CA; the bundle holds the internal CA and that CA.
  command: ["sh", "-c", "until bao read -field=certificate pki/cert/ca > /run/openmap/ca/services-ca.crt && grep -q CERTIFICATE /run/openmap/ca/services-ca.crt; do sleep {{ .Values.migrate.pollSeconds }}; done; echo >> /run/openmap/ca/services-ca.crt; cat /run/openmap/openbao-ca/ca.crt >> /run/openmap/ca/services-ca.crt"]
  {{- end }}
  env:
    - { name: BAO_ADDR, value: {{ include "openmap.vaultAddr" . | quote }} }
    {{- if or (not .Values.openbao.external.enabled) .Values.openbao.external.caBundle }}
    - { name: BAO_CACERT, value: /run/openmap/openbao-ca/ca.crt }
    {{- end }}
  volumeMounts:
    - { name: service-ca, mountPath: /run/openmap/ca }
    {{- if or (not .Values.openbao.external.enabled) .Values.openbao.external.caBundle }}
    - { name: openbao-ca, mountPath: /run/openmap/openbao-ca, readOnly: true }
    {{- end }}
{{- end -}}

{{- define "openmap.caVolume" -}}
- name: service-ca
  emptyDir: { medium: Memory, sizeLimit: 1Mi }
{{- if not .Values.openbao.external.enabled }}
- name: openbao-ca
  secret: { secretName: {{ include "openmap.fullname" . }}-openbao-tls, items: [{ key: ca.crt, path: ca.crt }] }
{{- else if .Values.openbao.external.caBundle }}
- name: openbao-ca
  configMap: { name: {{ include "openmap.fullname" . }}-openbao-external-ca }
{{- end }}
{{- end -}}

{{/* ADR-068: a pod that trusts OpenBao's CA rolls when the chart makes a new one. */}}
{{- define "openmap.openbaoCaChecksum" -}}
{{- if not .Values.openbao.external.enabled }}openmap.io/openbao-ca: {{ (include "openmap.openbaoTls" . | fromYaml).notAfter | sha256sum | trunc 16 | quote }}{{ end }}
{{- end -}}

{{- define "openmap.caMount" -}}
- { name: service-ca, mountPath: /run/openmap/ca, readOnly: true }
{{- end -}}

{{/* REQ-SEC-011 (ADR-067): the services' AppRole ids, mounted where OPENBAO_ROLE_ID_FILE / OPENBAO_SECRET_ID_FILE point. */}}
{{- define "openmap.vaultVolume" -}}
{{- if not .Values.openbao.external.enabled }}
- name: openbao-approle
  secret:
    secretName: {{ include "openmap.fullname" . }}-openbao-approle
    defaultMode: 0440
    items: [{ key: role-id, path: role-id }, { key: secret-id, path: secret-id }]
{{- end }}
{{- end -}}

{{- define "openmap.vaultMount" -}}
{{- if not .Values.openbao.external.enabled }}
- { name: openbao-approle, mountPath: /run/openmap/openbao, readOnly: true }
{{- end }}
{{- end -}}

{{/* Environment shared by every Node service; secrets are referenced, never inlined. */}}
{{- define "openmap.appEnv" -}}
- name: NODE_ENV
  value: production
- name: POSTGRES_URL
  valueFrom: { secretKeyRef: { name: {{ include "openmap.fullname" . }}-datastores, key: POSTGRES_URL } }
- name: MEMGRAPH_URL
  value: {{ if .Values.storeTls.enabled }}bolt+s{{ else }}bolt{{ end }}://{{ include "openmap.fullname" . }}-memgraph:7687
# ADR-068: HTTPS to ClickHouse, every TLS client verifying against the CA each pod fetches.
- name: CLICKHOUSE_URL
  value: https://{{ include "openmap.fullname" . }}-clickhouse:8443
- name: SERVICE_CA_PATH
  value: /run/openmap/ca/services-ca.crt
- name: CLICKHOUSE_USER
  value: {{ .Values.clickhouse.username | quote }}
- name: CLICKHOUSE_PASSWORD
  valueFrom: { secretKeyRef: { name: {{ include "openmap.fullname" . }}-datastores, key: CLICKHOUSE_PASSWORD } }
- name: CLICKHOUSE_DB
  value: {{ .Values.clickhouse.database | quote }}
- name: VALKEY_URL
  value: {{ if .Values.storeTls.enabled }}rediss{{ else }}redis{{ end }}://{{ include "openmap.fullname" . }}-valkey:6379
- name: MEILI_URL
  value: {{ if .Values.storeTls.enabled }}https{{ else }}http{{ end }}://{{ include "openmap.fullname" . }}-meilisearch:7700
- name: MEILI_MASTER_KEY
  valueFrom: { secretKeyRef: { name: {{ include "openmap.fullname" . }}-datastores, key: MEILI_MASTER_KEY } }
- name: KEYCLOAK_URL
  value: http://{{ include "openmap.fullname" . }}-keycloak:8080
- name: KEYCLOAK_REALM
  value: {{ .Values.keycloak.realm | quote }}
- name: OPENBAO_ADDR
  value: {{ include "openmap.vaultAddr" . | quote }}
- name: OPENBAO_MOUNT
  value: {{ .Values.openbao.mount | quote }}
{{- if .Values.openbao.external.enabled }}
- name: OPENBAO_TOKEN
  valueFrom: { secretKeyRef: { name: {{ include "openmap.fullname" . }}-datastores, key: OPENBAO_TOKEN } }
{{- else }}
- name: OPENBAO_ROLE_ID_FILE
  value: /run/openmap/openbao/role-id
- name: OPENBAO_SECRET_ID_FILE
  value: /run/openmap/openbao/secret-id
{{- end }}
- name: PUBLIC_API_URL
  value: {{ .Values.api.publicUrl | quote }}
- name: PUBLIC_CONSOLE_URL
  value: {{ .Values.console.publicUrl | quote }}
{{- if .Values.console.aliasUrl }}
- name: PUBLIC_CONSOLE_ALIAS_URL
  value: {{ .Values.console.aliasUrl | quote }}
{{- end }}
- name: PUBLIC_KEYCLOAK_URL
  value: {{ .Values.keycloak.publicUrl | quote }}
{{- if .Values.llm.enabled }}
- name: LLM_URL
  value: {{ .Values.llm.url | quote }}
{{- end }}
{{- end -}}

{{/*
REQ-SEC-011 (ADR-068): the OpenBao Agent sidecar beside Valkey, Memgraph or Meilisearch (files/openbao/agent-store-tls.hcl):
keeps the store's server certificate on a memory volume shared with the store. Arguments: root, component, uid, gid, ttl.
*/}}
{{- define "openmap.storeTlsAgent" -}}
- name: certs
  image: {{ if .root.Values.image.registry }}{{ .root.Values.image.registry }}/{{ end }}{{ .root.Values.openbao.image }}
  imagePullPolicy: {{ .root.Values.image.pullPolicy }}
  args: ["agent", "-config=/openbao/config/agent-store-tls.hcl"]
  securityContext: { runAsUser: {{ .uid }}, runAsGroup: {{ .gid }} }
  env:
    - { name: BAO_ADDR, value: {{ include "openmap.vaultAddr" .root | quote }} }
    - { name: BAO_CACERT, value: /run/openmap/ca/services-ca.crt }
    - { name: TLS_NAME, value: {{ include "openmap.svc" (dict "root" .root "component" .component) | quote }} }
    - { name: TLS_TTL, value: {{ .ttl | quote }} }
  resources: {{- toYaml .root.Values.storeTls.agentResources | nindent 4 }}
  volumeMounts:
    - { name: store-tls, mountPath: /run/store-tls }
    - { name: store-approle, mountPath: /openbao/approle-store, readOnly: true }
    - { name: store-tls-files, mountPath: /openbao/config/agent-store-tls.hcl, subPath: agent-store-tls.hcl, readOnly: true }
    {{- include "openmap.caMount" .root | nindent 4 }}
{{- end -}}

{{- define "openmap.storeTlsVolumes" -}}
# The certificate and key never touch a disk.
- name: store-tls
  emptyDir: { medium: Memory, sizeLimit: 1Mi }
- name: store-tls-files
  configMap: { name: {{ include "openmap.fullname" . }}-store-tls, defaultMode: 0555 }
- name: store-approle
  secret:
    {{- if .Values.openbao.external.enabled }}
    secretName: {{ required "storeTls.externalApproleSecret is required with openbao.external and storeTls" .Values.storeTls.externalApproleSecret }}
    items: [{ key: role-id, path: role-id }, { key: secret-id, path: secret-id }]
    {{- else }}
    secretName: {{ include "openmap.fullname" . }}-openbao-approle
    items: [{ key: stores-role-id, path: role-id }, { key: stores-secret-id, path: secret-id }]
    {{- end }}
    defaultMode: 0440
{{- end -}}
